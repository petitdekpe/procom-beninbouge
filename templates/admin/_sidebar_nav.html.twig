    ] },
    { label: 'Équipe et accès', key: 'acces', items: [
        { label: 'Auteurs', href: 'admin_author_index', prefix: 'admin_author', perm: 'authors.manage',
          icon: '<circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-6.5 7-6.5s7 2.9 7 6.5"/>' },
        { label: 'Utilisateurs', href: 'admin_user_index', prefix: 'admin_user', perm: 'users.manage',
          icon: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c0-3.2 2.5-5.8 5.5-5.8s5.5 2.6 5.5 5.8"/><path d="M16 4.5c1.5.3 2.6 1.7 2.6 3.3s-1.1 3-2.6 3.3"/><path d="M19 13.5c1.7.4 3 1.9 3 3.7"/>' },
        { label: 'Rôles et permissions', href: 'admin_role_index', prefix: 'admin_role', perm: 'roles.manage',
          icon: '<path d="M12 3l7 3v6c0 4.5-3 7-7 9-4-2-7-4.5-7-9V6Z"/><path d="M12 8v5"/><circle cx="12" cy="15.5" r=".6"/>' },
    ] },
] %}
<nav class="bo-nav" aria-label="Navigation de l'administration">
    {% for group in navGroups %}
        {% set visible = group.items|filter(item => is_granted(item.perm)) %}
        {% if visible|length > 0 %}
            {% set groupActive = visible|filter(item => route starts with item.prefix)|length > 0 %}

            {% if group.label is null %}
                {% for item in visible %}
                    <a href="{{ path(item.href) }}" class="bo-nav-link {{ route starts with item.prefix ? 'active' : '' }}" title="{{ item.label }}">
                        <svg viewBox="0 0 24 24">{{ item.icon|raw }}</svg>
                        <span class="bo-label">{{ item.label }}</span>
                    </a>
                {% endfor %}
            {% else %}
                <details class="bo-nav-group" data-nav-group="{{ group.key }}"{{ groupActive ? ' open data-active' : '' }}>
                    <summary class="bo-nav-group-label">
                        <span class="bo-label">{{ group.label }}</span>
                        <svg class="bo-nav-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    {% for item in visible %}
                        <a href="{{ path(item.href) }}" class="bo-nav-link {{ route starts with item.prefix ? 'active' : '' }}" title="{{ item.label }}">
                            <svg viewBox="0 0 24 24">{{ item.icon|raw }}</svg>
                            <span class="bo-label">{{ item.label }}</span>
                        </a>
                    {% endfor %}
                </details>
            {% endif %}
        {% endif %}
    {% endfor %}
</nav>
