        { label: 'Validations', href: 'admin_validation_index', prefix: 'admin_validation', perm: 'validations.manage',
          icon: '<path d="M12 3l7 3v6c0 4.5-3 7-7 9-4-2-7-4.5-7-9V6Z"/><path d="m9 12 2 2 4-4"/>' },
    ] },
    { label: 'Régie', key: 'regie', items: [
