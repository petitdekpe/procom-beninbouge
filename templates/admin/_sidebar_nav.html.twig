    ] },
    { label: 'Site', key: 'site', items: [
        { label: 'Page d\'accueil', href: 'admin_home_section_index', prefix: 'admin_home_section', perm: 'home.manage',
          icon: '<path d="M4 10.5 12 4l8 6.5"/><path d="M6 9.5V19a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V9.5"/><path d="M10 20v-5h4v5"/>' },
        { label: 'Pages', href: 'admin_page_index', prefix: 'admin_page', perm: 'pages.manage',
