{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Mot de passe{% endblock %}

{% block admin_body %}
    <div class="bo-page-head">
        <h1 class="bo-page-title">Mon mot de passe</h1>
    </div>

    {% if temporary %}
        <div class="bo-flash" style="background:#fff7e0;color:#7a5b00">Vous utilisez un mot de passe temporaire. Choisissez le vôtre pour accéder à l'administration.</div>
    {% endif %}

    <div class="bo-card" style="padding:28px;max-width:560px">
        {{ form_start(form) }}
            <div class="bo-form-row">{{ form_row(form.currentPassword) }}</div>
            <div class="bo-form-row">{{ form_row(form.newPassword.first) }}</div>
            <div class="bo-form-row">{{ form_row(form.newPassword.second) }}</div>
            {{ form_errors(form.newPassword) }}
            <div style="margin-top:22px">
                <button type="submit" class="bo-btn bo-btn-black">Enregistrer le mot de passe</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
