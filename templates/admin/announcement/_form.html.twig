{# Formulaire d'annonce de la rédaction (création et modification).
   Attend : form, heading, submitLabel, intro (texte d'aide), currentImage et currentDocument (URL ou null). #}
{{ form_start(form, { attr: { class: 'bo-wizard', enctype: 'multipart/form-data' } }) }}
    <div class="bo-wizard-head">
        <div>
            <p class="bo-wizard-title">{{ heading }}</p>
            <div class="bo-stepper">
                <button type="button" class="bo-stepper-tab">Annonce</button>
                <span class="bo-stepper-sep">›</span>
                <button type="button" class="bo-stepper-tab">Contact et diffusion</button>
                <span class="bo-stepper-sep">›</span>
                <button type="button" class="bo-stepper-tab">Vérifier</button>
            </div>
        </div>
        <a href="{{ path('admin_announcement_index') }}" class="bo-wizard-close" title="Fermer">✕</a>
    </div>

    <div class="bo-step">
        <p class="bo-muted" style="margin:0 0 16px">{{ intro }}</p>
        <div class="bo-form-row">{{ form_row(form.category) }}</div>
        <div class="bo-form-row">{{ form_row(form.title) }}</div>
        <div class="bo-form-row">{{ form_row(form.slug) }}</div>
        <div class="bo-form-row">{{ form_row(form.organization) }}</div>
        <div class="bo-form-row">{{ form_row(form.location) }}</div>
        <div class="bo-form-row">{{ form_row(form.deadline) }}</div>
        <div class="bo-form-row">{{ form_row(form.description) }}</div>
        <div class="bo-form-row">{{ form_row(form.externalUrl) }}</div>
        {% if currentDocument %}
            <div class="bo-form-row">
                <p style="margin:0 0 4px;font-weight:700">Document actuel</p>
                <a href="{{ currentDocument }}" target="_blank" rel="noopener">Ouvrir le document</a>
            </div>
        {% endif %}
        <div class="bo-form-row">{{ form_row(form.documentFile) }}</div>
        {% if form.removeDocument is defined %}<div class="bo-form-row">{{ form_row(form.removeDocument) }}</div>{% endif %}
        {% if currentImage %}
            <div class="bo-form-row">
                <p style="margin:0 0 8px;font-weight:700">Image actuelle</p>
                <img src="{{ currentImage }}" alt="" style="display:block;max-width:220px;max-height:220px;border-radius:10px">
            </div>
        {% endif %}
        <div class="bo-form-row">{{ form_row(form.imageFile) }}</div>
        {% if form.removeImage is defined %}<div class="bo-form-row">{{ form_row(form.removeImage) }}</div>{% endif %}
    </div>

    <div class="bo-step">
        <p class="bo-muted" style="margin:0 0 16px">Coordonnées facultatives : laissez vide si l'annonce renvoie vers un lien ou un document.</p>
        <div class="bo-form-row">{{ form_row(form.contactName) }}</div>
        <div class="bo-form-row">{{ form_row(form.contactEmail) }}</div>
        <div class="bo-form-row">{{ form_row(form.contactPhone) }}</div>
        <div class="bo-form-row">{{ form_row(form.showContact) }}</div>
        <div class="bo-form-row">{{ form_row(form.durationDays) }}</div>
        <div class="bo-form-row">{{ form_row(form.withHomeCard) }}</div>
        <div class="bo-form-row">{{ form_row(form.withPopup) }}</div>
    </div>

    <div class="bo-step">
        <h2 style="font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:var(--sp-muted);margin:0 0 4px">Récapitulatif</h2>
        <div data-review></div>
    </div>

    {{ form_rest(form) }}

    <div class="bo-wizard-footer">
        <button type="button" class="bo-btn bo-btn-muted" data-step-prev>← Précédent</button>
        <div style="display:flex;gap:10px">
            <a href="{{ path('admin_announcement_index') }}" class="bo-btn bo-btn-muted">Annuler</a>
            <button type="button" class="bo-btn bo-btn-black" data-step-next>Suivant</button>
            <button type="submit" class="bo-btn bo-btn-accent" data-step-submit>{{ submitLabel }}</button>
        </div>
    </div>
{{ form_end(form) }}
