{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Catégories{% endblock %}

{% block admin_body %}
    <div class="bo-page-head">
        <h1 class="bo-page-title">Catégories</h1>
        <a href="{{ path('admin_category_new') }}" class="bo-btn bo-btn-accent">+ Nouvelle catégorie</a>
    </div>

    <div data-list-root>
        <div class="bo-toolbar">
            <div class="bo-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-3.8-3.8"/></svg>
                <input type="text" data-list-search placeholder="Rechercher des catégories">
            </div>
        </div>

        <div class="bo-card">
            {% if categories|length > 0 %}
                <table class="bo-table">
                    <thead>
                        <tr><th>Nom</th><th>Couleur</th><th>Catégorie parente</th><th>Slug</th><th>URL publique</th><th></th></tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                            <tr data-search="{{ (category.name ~ ' ' ~ category.slug ~ ' ' ~ (category.parent ? category.parent.name : ''))|lower }}">
                                <td style="font-weight:700">{% if category.parent %}<span class="bo-muted" style="font-weight:400">↳ </span>{% endif %}{{ category.name }}</td>
                                <td><span style="display:inline-block;width:16px;height:16px;border-radius:4px;background:{{ category.color }};vertical-align:middle;margin-right:6px"></span><span class="bo-muted">{{ category.color }}</span></td>
                                <td class="bo-muted">{{ category.parent ? category.parent.name : '—' }}</td>
                                <td class="bo-muted">{{ category.slug }}</td>
                                <td class="bo-muted"><a href="{{ path('app_category_show', { slug: category.slug }) }}" target="_blank">{{ path('app_category_show', { slug: category.slug }) }}</a></td>
                                <td style="text-align:right;white-space:nowrap">
                                    <a href="{{ path('admin_category_edit', { id: category.id }) }}" class="bo-btn bo-btn-muted">Modifier</a>
                                    <form method="post" action="{{ path('admin_category_delete', { id: category.id }) }}" style="display:inline" onsubmit="return confirm('Supprimer cette catégorie ?');">
                                        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                        <button type="submit" class="bo-btn bo-btn-danger">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="bo-empty">Aucune catégorie pour le moment.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
