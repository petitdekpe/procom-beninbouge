{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Commentaires{% endblock %}

{% block admin_body %}
    <div class="bo-page-head">
        <h1 class="bo-page-title">Commentaires</h1>
    </div>

    <div class="bo-toolbar">
        <div class="bo-filters">
            <a href="{{ path('admin_comment_index', { status: 'pending' }) }}" class="bo-pill {{ currentStatus.value == 'pending' ? 'active' : '' }}">En attente{% if pendingCount > 0 %} ({{ pendingCount }}){% endif %}</a>
            <a href="{{ path('admin_comment_index', { status: 'approved' }) }}" class="bo-pill {{ currentStatus.value == 'approved' ? 'active' : '' }}">Approuvés</a>
            <a href="{{ path('admin_comment_index', { status: 'rejected' }) }}" class="bo-pill {{ currentStatus.value == 'rejected' ? 'active' : '' }}">Rejetés</a>
        </div>
    </div>

    <div class="bo-card">
        {% if comments|length > 0 %}
            <table class="bo-table">
                <thead>
                    <tr><th>Auteur</th><th>Commentaire</th><th>Article</th><th>Date</th><th style="text-align:right">Actions</th></tr>
                </thead>
                <tbody>
                    {% for comment in comments %}
                        <tr>
                            <td style="font-weight:700">{{ comment.authorName }}{% if comment.authorEmail %}<div class="bo-muted" style="font-weight:400;font-size:11.5px">{{ comment.authorEmail }}</div>{% endif %}</td>
                            <td style="max-width:360px">{{ comment.content|length > 160 ? comment.content|slice(0, 160) ~ '…' : comment.content }}</td>
                            <td class="bo-muted"><a href="{{ path('app_article_show', { slug: comment.article.slug }) }}" target="_blank">{{ comment.article.title }}</a></td>
                            <td class="bo-muted">{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                            <td style="text-align:right;white-space:nowrap">
                                {% if currentStatus.value != 'approved' %}
                                    <form method="post" action="{{ path('admin_comment_approve', { id: comment.id, status: currentStatus.value }) }}" style="display:inline">
                                        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                        <button type="submit" class="bo-btn bo-btn-accent">Approuver</button>
                                    </form>
                                {% endif %}
                                {% if currentStatus.value != 'rejected' %}
                                    <form method="post" action="{{ path('admin_comment_reject', { id: comment.id, status: currentStatus.value }) }}" style="display:inline">
                                        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                        <button type="submit" class="bo-btn bo-btn-muted">Rejeter</button>
                                    </form>
                                {% endif %}
                                <form method="post" action="{{ path('admin_comment_delete', { id: comment.id, status: currentStatus.value }) }}" style="display:inline" onsubmit="return confirm('Supprimer définitivement ce commentaire ?');">
                                    <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                    <button type="submit" class="bo-btn bo-btn-danger">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="bo-empty">Aucun commentaire {{ currentStatus.value == 'pending' ? 'en attente' : (currentStatus.value == 'approved' ? 'approuvé' : 'rejeté') }}.</p>
        {% endif %}
    </div>
{% endblock %}
