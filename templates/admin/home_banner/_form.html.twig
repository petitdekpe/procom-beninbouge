{{ form_start(form, { attr: { class: 'bo-wizard', enctype: 'multipart/form-data' } }) }}
    <div class="bo-wizard-head">
        <div>
            <p class="bo-wizard-title">{{ heading }}</p>
            <div class="bo-stepper">
                <button type="button" class="bo-stepper-tab">Publicité</button>
                <span class="bo-stepper-sep">›</span>
                <button type="button" class="bo-stepper-tab">Diffusion</button>
                <span class="bo-stepper-sep">›</span>
                <button type="button" class="bo-stepper-tab">Vérifier</button>
            </div>
        </div>
        <a href="{{ path('admin_home_banner_index') }}" class="bo-wizard-close" title="Fermer">✕</a>
    </div>

    <div class="bo-step">
        <div class="bo-form-row">{{ form_row(form.title) }}</div>
        {% if banner.imageUrl %}
            <div class="bo-form-row">
                <p class="bo-muted" style="margin:0 0 6px;font-size:12.5px">Image actuelle</p>
                <img src="{{ banner.imageUrl }}" alt="" style="width:100%;max-width:520px;aspect-ratio:16/5;object-fit:cover;border-radius:10px;border:1px solid var(--sp-border)">
            </div>
        {% endif %}
        <div class="bo-form-row">{{ form_row(form.imageFile) }}</div>
        <div class="bo-form-row">{{ form_row(form.imageUrl) }}</div>
        <div class="bo-form-row">{{ form_row(form.linkUrl) }}</div>
    </div>

    <div class="bo-step">
        <div class="bo-form-row">{{ form_row(form.advertiser) }}</div>
        <div class="bo-form-row">{{ form_row(form.startsAt) }}</div>
        <div class="bo-form-row">{{ form_row(form.durationDays) }}</div>
        <div class="bo-form-row">{{ form_row(form.amount) }}</div>
        <div class="bo-form-row">{{ form_row(form.contactName) }}</div>
        <div class="bo-form-row">{{ form_row(form.contactEmail) }}</div>
        <div class="bo-form-row">{{ form_row(form.contactPhone) }}</div>
        <div class="bo-form-row">{{ form_row(form.enabled) }}</div>
    </div>

    <div class="bo-step">
        <h2 style="font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:var(--sp-muted);margin:0 0 4px">Récapitulatif</h2>
        <div data-review></div>
    </div>

    {{ form_rest(form) }}

    <div class="bo-wizard-footer">
        <button type="button" class="bo-btn bo-btn-muted" data-step-prev>← Précédent</button>
        <div style="display:flex;gap:10px">
            <a href="{{ path('admin_home_banner_index') }}" class="bo-btn bo-btn-muted">Annuler</a>
            <button type="button" class="bo-btn bo-btn-black" data-step-next>Suivant</button>
            <button type="submit" class="bo-btn bo-btn-accent" data-step-submit>Enregistrer</button>
        </div>
    </div>
{{ form_end(form) }}
