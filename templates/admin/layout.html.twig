{% extends 'base.html.twig' %}

{% block title %}{% block admin_title %}Backoffice{% endblock %} | {{ site_settings().siteName }}{% endblock %}

{# Le back-office garde son propre style : ni la charte publique (.bb-site),
   ni le thème sombre, ni les polices du site public. #}
{% block theme_head %}{% endblock %}
{% block analytics %}{% endblock %}
{% block body_attributes %}{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
    <style>
        :root{
            --sp-bg:#f6f6f7;
            --sp-border:#e5e5e6;
            --sp-black:#0a0a0a;
            --sp-muted:#6a6a6e;
            --sp-accent:#6c5dd3;
            --sp-accent-soft:#c7c2f4;
            --sp-accent-soft-text:#18163a;
            --sp-green:#1ed760;
            --sp-amber:#f5a623;
            --sp-gray-dot:#b3b3b3;
            --sp-danger-bg:#fdecee;
            --sp-danger-text:#a3173a;
        }
        *{box-sizing:border-box}
        body{margin:0;font-family:'Manrope',system-ui,sans-serif;background:var(--sp-bg);color:var(--sp-black);-webkit-font-smoothing:antialiased}
        a{color:inherit}

        .bo-app{display:flex;flex-direction:column;min-height:100vh}

        .bo-topbar{flex:none;height:56px;background:#fff;border-bottom:1px solid var(--sp-border);display:flex;align-items:center;justify-content:space-between;padding:0 22px;position:sticky;top:0;z-index:30}
        .bo-topbar-brand{display:flex;align-items:center;gap:9px;font-weight:900;font-size:14.5px;text-decoration:none}
        .bo-topbar-brand .mark{width:24px;height:24px;border-radius:7px;background:var(--sp-black);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900}
        .bo-topbar-right{display:flex;align-items:center;gap:10px}
        .bo-icon-btn{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--sp-muted);background:none;border:none;cursor:pointer}
        .bo-icon-btn:hover{background:var(--sp-bg)}
        .bo-icon-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
        .bo-avatar{width:30px;height:30px;border-radius:50%;background:var(--sp-black);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12.5px}
        .bo-topbar-site{font-weight:700;font-size:13px;color:var(--sp-muted);text-decoration:none}
        .bo-topbar-site:hover{color:var(--sp-black)}

        .bo-body-row{display:flex;flex:1;min-height:0}

        .bo-sidebar{flex:none;width:256px;background:#fff;border-right:1px solid var(--sp-border);padding:18px 14px;display:flex;flex-direction:column;transition:width .15s ease}
        .bo-app.bo-collapsed .bo-sidebar{width:72px;padding:18px 10px}
        .bo-app.bo-collapsed .bo-sidebar .bo-label{display:none}
        .bo-app.bo-collapsed .bo-new-btn{padding:11px}

        .bo-new-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:var(--sp-black);color:#fff;font-weight:800;font-size:13.5px;padding:11px 14px;border-radius:999px;text-decoration:none;margin-bottom:18px}
        .bo-new-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;flex:none}

        .bo-nav{display:flex;flex-direction:column;gap:3px}
        .bo-nav-link{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:999px;color:#4a4a4d;text-decoration:none;font-weight:700;font-size:13.5px}
        .bo-nav-link svg{flex:none;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
        .bo-nav-link:hover{background:var(--sp-bg)}
        .bo-nav-link.active{background:var(--sp-black);color:#fff}
        .bo-pill{text-decoration:none}
        .bo-btn-sm{padding:7px 13px;font-size:12.5px}
        .bo-actions{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end}
        .bo-actions form{display:inline;margin:0}
        .bo-nav-group{margin-top:4px}
        .bo-nav-group>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;cursor:pointer;padding:12px 14px 6px;font-size:11px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;color:var(--sp-muted);border-radius:8px;user-select:none}
        .bo-nav-group>summary::-webkit-details-marker{display:none}
        .bo-nav-group>summary:hover{color:var(--sp-black)}
        .bo-nav-group>summary:focus-visible{outline:2px solid var(--sp-accent);outline-offset:2px}
        .bo-nav-chevron{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .15s ease}
        .bo-nav-group:not([open]) .bo-nav-chevron{transform:rotate(-90deg)}
        .bo-nav-group[open]>.bo-nav-link{margin-top:0}
        .bo-nav-group>.bo-nav-link{margin-bottom:2px}
        .bo-app.bo-collapsed .bo-nav-group>summary{padding:10px 0 4px;justify-content:center;border-top:1px solid var(--sp-border);border-radius:0;margin-top:6px}
        .bo-app.bo-collapsed .bo-nav-chevron{display:none}
        .bo-user{position:relative}
        .bo-user>summary{list-style:none;cursor:pointer;display:flex}
        .bo-user>summary::-webkit-details-marker{display:none}
        .bo-user-menu{position:absolute;right:0;top:40px;min-width:230px;background:#fff;border:1px solid var(--sp-border);border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.12);padding:8px;z-index:40}
        .bo-user-menu .who{padding:8px 10px 10px;border-bottom:1px solid var(--sp-border);margin-bottom:6px}
        .bo-user-menu .who strong{display:block;font-size:13.5px}
        .bo-user-menu .who span{font-size:12px;color:var(--sp-muted);word-break:break-all}
        .bo-user-menu a{display:block;padding:9px 10px;border-radius:8px;text-decoration:none;font-weight:700;font-size:13.5px}
        .bo-user-menu a:hover{background:var(--sp-bg)}
        .bo-flash-info{background:#fff7e0;color:#7a5b00}

        .bo-sidebar-collapse{margin-top:auto;align-self:flex-start;width:30px;height:30px;border-radius:50%;border:1px solid var(--sp-border);background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--sp-muted)}
        .bo-sidebar-collapse svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .15s ease}
        .bo-app.bo-collapsed .bo-sidebar-collapse svg{transform:rotate(180deg)}

        .bo-content{flex:1;min-width:0;padding:30px 36px 60px}

        .bo-page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:20px;flex-wrap:wrap}
        .bo-page-title{font-family:'Anton',system-ui,sans-serif;font-size:32px;letter-spacing:.3px;margin:0;font-weight:400}

        .bo-btn{display:inline-flex;align-items:center;gap:6px;text-decoration:none;font-weight:800;font-size:13.5px;padding:10px 18px;border-radius:999px;border:none;cursor:pointer;white-space:nowrap}
        .bo-btn-accent{background:var(--sp-accent-soft);color:var(--sp-accent-soft-text)}
        .bo-btn-black{background:var(--sp-black);color:#fff}
        .bo-btn-danger{background:var(--sp-danger-bg);color:var(--sp-danger-text)}
        .bo-btn-muted{background:#f0f0f1;color:var(--sp-black)}

        .bo-toggle{position:relative;display:inline-block;width:40px;height:22px;vertical-align:middle}
        .bo-toggle input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
        .bo-toggle-track{position:absolute;inset:0;background:var(--sp-border);border-radius:999px;transition:background .15s ease}
        .bo-toggle-track::before{content:"";position:absolute;width:16px;height:16px;left:3px;top:3px;background:#fff;border-radius:50%;transition:transform .15s ease;box-shadow:0 1px 2px rgba(0,0,0,.25)}
        .bo-toggle input:checked + .bo-toggle-track{background:var(--sp-green)}
        .bo-toggle input:checked + .bo-toggle-track::before{transform:translateX(18px)}
        .bo-toggle input:focus-visible + .bo-toggle-track{outline:2px solid var(--sp-accent);outline-offset:2px}

        .bo-select{padding:8px 11px;border:1px solid var(--sp-border);border-radius:9px;font-family:inherit;font-size:13.5px;background:#fff;color:var(--sp-black)}

        .bo-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px;flex-wrap:wrap}
        .bo-search{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--sp-border);border-radius:999px;padding:9px 16px;min-width:260px}
        .bo-search svg{width:15px;height:15px;flex:none;fill:none;stroke:var(--sp-muted);stroke-width:1.8}
        .bo-search input{border:none;outline:none;font-family:inherit;font-size:13.5px;flex:1;background:transparent}
        .bo-filters{display:flex;gap:8px;flex-wrap:wrap}
        .bo-pill{border:1px solid var(--sp-border);background:#fff;color:var(--sp-muted);font-weight:700;font-size:12.5px;padding:7px 14px;border-radius:999px;cursor:pointer}
        .bo-pill.active{background:var(--sp-black);color:#fff;border-color:var(--sp-black)}

        .bo-card{background:#fff;border:1px solid var(--sp-border);border-radius:14px;overflow:hidden}
        .bo-card:has(> table.bo-table){overflow-x:auto}
        .bo-table{width:100%;border-collapse:collapse;font-size:13.5px}
        .bo-table th{text-align:left;color:var(--sp-muted);font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:800;padding:13px 16px;border-bottom:1px solid var(--sp-border)}
        .bo-table td{padding:12px 16px;border-bottom:1px solid #f1f1f2;vertical-align:middle}
        .bo-table tr:last-child td{border-bottom:none}
        .bo-row-title{display:flex;align-items:center;gap:10px;font-weight:700}
        .bo-thumb{width:34px;height:34px;border-radius:7px;object-fit:cover;flex:none;background:#eee}
        .bo-thumb-fallback{width:34px;height:34px;border-radius:7px;flex:none;background:var(--sp-black);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px}
        .bo-status{display:inline-flex;align-items:center;gap:7px;font-weight:700;font-size:13px}
        .bo-status .dot{width:8px;height:8px;border-radius:50%;flex:none}
        .bo-format-badge{display:inline-block;border:1px solid var(--sp-border);border-radius:6px;padding:3px 9px;font-size:11.5px;font-weight:800;text-transform:capitalize}
        .bo-empty{color:var(--sp-muted);padding:32px;text-align:center}
        .bo-muted{color:var(--sp-muted)}

        .bo-flash{padding:12px 16px;border-radius:10px;margin-bottom:16px;font-weight:700;font-size:13.5px}
        .bo-flash-success{background:#e7f9ee;color:#0b6b32}
        .bo-flash-error{background:var(--sp-danger-bg);color:var(--sp-danger-text)}

        /* Wizard (multi-step create/edit forms) */
        .bo-wizard-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px;padding-bottom:16px;border-bottom:1px solid var(--sp-border)}
        .bo-wizard-title{font-weight:900;font-size:15px;margin:0 0 8px}
        .bo-stepper{display:flex;align-items:center;gap:10px;font-weight:700;font-size:14px;color:#b9b9bb;flex-wrap:wrap}
        .bo-stepper-sep{color:#d3d3d5}
        .bo-stepper-tab{background:none;border:none;cursor:pointer;font:inherit;color:inherit;padding:0 0 4px;border-bottom:2px solid transparent}
        .bo-stepper-tab.active{color:var(--sp-black);border-bottom-color:var(--sp-accent)}
        .bo-stepper-tab.done{color:#4a4a4d}
        .bo-wizard-close{color:var(--sp-muted);text-decoration:none;font-size:20px;line-height:1}
        .bo-step{max-width:640px}
        .bo-form-row{margin-bottom:18px}
        .bo-form-row label{display:block;font-weight:700;font-size:13px;margin-bottom:6px}
        .bo-form-row input[type=text],.bo-form-row input[type=email],.bo-form-row input[type=password],.bo-form-row input[type=number],
        .bo-form-row input[type=datetime-local],.bo-form-row textarea,.bo-form-row select{
            width:100%;padding:10px 13px;border:1px solid var(--sp-border);border-radius:9px;font-family:inherit;font-size:14px;background:#fff
        }
        .bo-form-row select[multiple]{height:120px}
        .bo-form-row input[type=checkbox]{width:auto;margin-right:8px}
        .bo-form-row .help,.bo-form-row .form-help,.bo-form-row .help-text{color:var(--sp-muted);font-size:12px;margin-top:5px}
        .bo-form-row ul{color:var(--sp-danger-text);font-size:12.5px;font-weight:700;list-style:none;margin-top:6px;padding:0}
        .bo-richtext .ql-toolbar.ql-snow{border:1px solid var(--sp-border);border-bottom:none;border-radius:9px 9px 0 0;background:#fafafa}
        .bo-richtext .ql-container.ql-snow{border:1px solid var(--sp-border);border-radius:0 0 9px 9px;font-family:inherit;font-size:14px;background:#fff}
        .bo-richtext .ql-editor{min-height:140px}
        .bo-richtext.bo-richtext-tall .ql-editor{min-height:340px}
        .bo-wizard-footer{display:flex;justify-content:space-between;margin-top:26px;padding-top:18px;border-top:1px solid var(--sp-border)}
        .bo-review-row{display:flex;justify-content:space-between;gap:18px;padding:11px 0;border-bottom:1px solid #f1f1f2;font-size:13.5px}
        .bo-review-row span{color:var(--sp-muted)}
        .bo-review-row strong{font-weight:700;text-align:right}

        .bo-wizard-footer>div{margin-left:auto}

        /* Éléments propres au mobile : masqués sur grand écran. */
        .bo-menu-btn,.bo-drawer-head,.bo-drawer-site,.bo-backdrop,.bo-tabbar{display:none}

        /*
         * Tablette (721–900px) : la barre latérale passe en mode icônes seules
         * (même rendu que le repli manuel bo-collapsed, piloté par la largeur).
         */
        @media (min-width: 721px) and (max-width: 900px) {
            .bo-sidebar{width:72px;padding:18px 10px}
            .bo-sidebar .bo-label{display:none}
            .bo-new-btn{padding:11px}
            .bo-content{padding:22px 16px 40px}
        }

        /*
         * Mobile (≤720px) : menu complet dans un tiroir ouvert par le bouton
         * ☰ ou l'onglet « Menu », barre d'onglets fixe en bas pour le pouce,
         * tableaux affichés en cartes (étiquettes posées par le script en bas
         * de page), boutons et champs agrandis pour le tactile, barre
         * d'actions des formulaires collée en bas de l'écran.
         */
        @media (max-width: 720px) {
            :root{--bo-tabbar-h:62px}
            body{padding-bottom:calc(var(--bo-tabbar-h) + env(safe-area-inset-bottom))}

            .bo-topbar{height:54px;padding:0 8px 0 4px;gap:6px}
            .bo-topbar-brand{min-width:0;font-size:14px}
            .bo-topbar-brand .bo-brand-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
            .bo-topbar-right{gap:4px}
            .bo-topbar-site,.bo-topbar-notif{display:none}
            .bo-menu-btn{display:flex;width:44px;height:44px;flex:none}
            .bo-menu-btn svg{width:22px;height:22px}
            .bo-user>summary{padding:7px}
            .bo-user-menu{position:fixed;top:56px;right:8px;left:8px;min-width:0}
            .bo-user-menu a{padding:13px 12px;font-size:15px}

            /* Tiroir de navigation */
            .bo-sidebar{position:fixed;top:0;left:0;bottom:0;z-index:60;width:min(86vw,320px);padding:12px 12px calc(16px + env(safe-area-inset-bottom));overflow-y:auto;overscroll-behavior:contain;border-right:none;box-shadow:0 0 40px rgba(0,0,0,.18);transform:translateX(-105%);visibility:hidden;transition:transform .25s cubic-bezier(.2,.8,.2,1),visibility 0s linear .25s}
            .bo-app.bo-drawer-open .bo-sidebar{transform:none;visibility:visible;transition:transform .25s cubic-bezier(.2,.8,.2,1),visibility 0s}
            .bo-app .bo-sidebar .bo-label,.bo-app.bo-collapsed .bo-sidebar .bo-label{display:inline}
            .bo-app.bo-collapsed .bo-sidebar{width:min(86vw,320px);padding:12px 12px calc(16px + env(safe-area-inset-bottom))}
            .bo-app.bo-collapsed .bo-new-btn{padding:13px 14px}
            .bo-app.bo-collapsed .bo-nav-group>summary{padding:14px 14px 6px;justify-content:space-between;border-top:none;border-radius:8px;margin-top:0}
            .bo-app.bo-collapsed .bo-nav-chevron{display:inline}
            .bo-sidebar-collapse{display:none}
            .bo-drawer-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:2px 2px 12px;margin-bottom:12px;border-bottom:1px solid var(--sp-border)}
            .bo-drawer-head .bo-topbar-brand{font-size:14px}
            .bo-drawer-head .bo-icon-btn{width:44px;height:44px}
            .bo-new-btn{padding:13px 14px;font-size:15px}
            .bo-nav-link{padding:13px 14px;font-size:15px}
            .bo-nav-link svg{width:20px;height:20px}
            .bo-nav-group>summary{padding:14px 14px 6px;font-size:11.5px}
            .bo-drawer-site{display:flex;margin-top:14px;padding-top:12px;border-top:1px solid var(--sp-border)}
            .bo-drawer-site .bo-nav-link{flex:1}
            .bo-backdrop{display:block;position:fixed;inset:0;z-index:55;background:rgba(10,10,10,.45);opacity:0;pointer-events:none;transition:opacity .25s ease}
            .bo-app.bo-drawer-open .bo-backdrop{opacity:1;pointer-events:auto}
            body.bo-noscroll{overflow:hidden}

            /* Barre d'onglets du bas */
            .bo-tabbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:50;height:calc(var(--bo-tabbar-h) + env(safe-area-inset-bottom));padding:0 4px env(safe-area-inset-bottom);background:rgba(255,255,255,.96);-webkit-backdrop-filter:saturate(180%) blur(12px);backdrop-filter:saturate(180%) blur(12px);border-top:1px solid var(--sp-border)}
            .bo-tab{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;background:none;border:none;padding:0;font:inherit;font-size:11px;font-weight:800;color:var(--sp-muted);text-decoration:none;cursor:pointer;-webkit-tap-highlight-color:transparent}
            .bo-tab svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
            .bo-tab.active{color:var(--sp-black)}
            .bo-tab.active svg{stroke-width:2.2}
            .bo-tab-fab{width:42px;height:26px;margin:-2px 0;border-radius:999px;background:var(--sp-black);color:#fff;display:flex;align-items:center;justify-content:center}
            .bo-tab-fab svg{width:18px;height:18px;stroke-width:2.4}
            .bo-tab-new.active .bo-tab-fab{background:var(--sp-accent)}
            .bo-app.bo-typing .bo-tabbar{display:none}

            /* Contenu */
            .bo-content{padding:18px 16px 32px}
            .bo-page-head{gap:12px;margin-bottom:16px}
            .bo-page-title{font-size:26px}
            .bo-page-head>div{flex-wrap:wrap}
            .bo-page-head>div:last-child:not(:first-child){width:100%}
            .bo-btn{min-height:42px;padding:10px 16px;font-size:14px;justify-content:center}
            .bo-btn-sm{min-height:36px;padding:7px 13px}
            .bo-card{overflow:hidden;overflow:clip}
            .bo-card[style*="padding"]{padding:16px !important}
            .bo-grid-2{grid-template-columns:1fr !important}
            .bo-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr)) !important;gap:10px !important}
            .bo-kpi-grid>.bo-card{padding:14px !important}
            .bo-kpi-grid>.bo-card>div:last-child{font-size:24px !important}
            .bo-flash{font-size:14px}

            /* Recherche et filtres : la recherche prend toute la largeur, les
               filtres défilent horizontalement sur une seule ligne. */
            .bo-toolbar{gap:10px;margin-bottom:12px}
            .bo-search{min-width:0;width:100%;padding:11px 16px}
            .bo-search input{font-size:16px}
            .bo-filters{flex-wrap:nowrap;overflow-x:auto;margin:0 -16px;padding:2px 16px;width:calc(100% + 32px);scrollbar-width:none;-webkit-overflow-scrolling:touch}
            .bo-filters::-webkit-scrollbar{display:none}
            .bo-pill{flex:none;padding:9px 15px;font-size:13.5px;white-space:nowrap}

            /* Tableaux en cartes (classe bo-stack posée par le script). */
            .bo-table.bo-stack,.bo-stack tbody{display:block}
            .bo-stack thead{display:none}
            .bo-stack tr{display:flex;flex-direction:column;padding:14px 16px;border-bottom:1px solid var(--sp-border)}
            .bo-stack tbody tr:last-child{border-bottom:none}
            .bo-stack td{display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:5px 0 !important;border:none !important;text-align:right !important;white-space:normal !important;max-width:none !important;font-size:14px;min-width:0}
            .bo-stack td::before{content:attr(data-label);flex:none;max-width:45%;margin-right:auto;padding-right:6px;text-align:left;color:var(--sp-muted);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.4px}
            .bo-stack td[data-title]{order:-1;display:block;text-align:left !important;font-size:15.5px;font-weight:700;padding:0 0 6px !important}
            .bo-stack td[data-title]::before,.bo-stack td[data-actions]::before,.bo-stack td[data-full]::before,.bo-stack td[data-label=""]::before{display:none}
            .bo-stack td[data-label=""]{justify-content:flex-end}
            .bo-stack td[data-full]{display:block;text-align:left !important}
            .bo-stack td[data-empty]{display:none}
            .bo-stack td>*{min-width:0 !important}
            .bo-stack td input[type=text]{min-width:0 !important;font-size:14px !important}
            .bo-stack .bo-row-title{font-size:15.5px}
            .bo-stack .bo-row-title img[style*="width:120px"]{width:96px !important}
            .bo-stack td[data-actions]{order:99;display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;padding-top:12px !important;text-align:left !important}
            .bo-stack td[data-actions]>*,.bo-stack td[data-actions] .bo-actions>*{margin:0 !important;min-width:0}
            .bo-stack td[data-actions] .bo-actions{display:contents}
            .bo-stack td[data-actions] .bo-btn{width:100%}
            .bo-stack td[data-actions] input[type=hidden]{display:none}

            /* Formulaires : 16px évite le zoom automatique d'iOS au focus. */
            .bo-form-row input[type=text],.bo-form-row input[type=email],.bo-form-row input[type=password],.bo-form-row input[type=number],
            .bo-form-row input[type=datetime-local],.bo-form-row input[type=url],.bo-form-row input[type=tel],.bo-form-row input[type=date],
            .bo-form-row textarea,.bo-form-row select,.bo-select{font-size:16px;min-height:46px;padding:11px 13px}
            .bo-form-row input[type=file]{max-width:100%;font-size:14px}
            .bo-form-row input[type=checkbox],.bo-form-row input[type=radio]{width:20px;height:20px;vertical-align:middle}
            .bo-form-row label{font-size:14px}
            .bo-richtext .ql-container.ql-snow{font-size:16px}
            .bo-richtext.bo-richtext-tall .ql-editor{min-height:260px}
            .bo-wizard-head{gap:12px;margin-bottom:16px;padding-bottom:12px}
            .bo-wizard-close{width:44px;height:44px;display:flex;align-items:center;justify-content:center;margin:-10px -10px 0 0;flex:none}
            .bo-stepper{gap:6px 8px;font-size:14px}
            .bo-stepper-tab{padding:6px 0}
            .bo-review-row{flex-direction:column;gap:2px}
            .bo-review-row strong{text-align:left}
            .bo-wizard-footer{position:sticky;bottom:calc(var(--bo-tabbar-h) + env(safe-area-inset-bottom));z-index:5;gap:8px;margin:20px -16px -16px;padding:12px 16px;background:rgba(255,255,255,.97);box-shadow:0 -6px 16px rgba(0,0,0,.05)}
            .bo-wizard-footer>div{gap:8px !important}
            .bo-wizard-footer .bo-btn{padding:10px 14px}
            .bo-app.bo-typing .bo-wizard-footer{bottom:0}
        }
    </style>
{% endblock %}

{% block body %}
    <div class="bo-app" id="bo-app">
        <header class="bo-topbar">
            <div style="display:flex;align-items:center;gap:2px;min-width:0">
                <button type="button" class="bo-icon-btn bo-menu-btn" data-drawer-open aria-controls="bo-sidebar" aria-expanded="false" aria-label="Ouvrir le menu">
                    <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                </button>
                <a href="{{ path('admin_dashboard') }}" class="bo-topbar-brand">
                    <span class="mark">BB</span> <span class="bo-brand-text">{{ site_settings().siteName }} · Admin</span>
                </a>
            </div>
            <div class="bo-topbar-right">
                <a href="{{ path('app_home') }}" class="bo-topbar-site">Voir le site →</a>
                <button type="button" class="bo-icon-btn bo-topbar-notif" title="Notifications" disabled>
                    <svg viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5"/><path d="M4 16h16l-1.2 2.2a1 1 0 0 1-.9.5H6.1a1 1 0 0 1-.9-.5L4 16Z"/><path d="M10.5 20a1.5 1.5 0 0 0 3 0"/></svg>
                </button>
                <details class="bo-user">
                    <summary aria-label="Menu du compte"><span class="bo-avatar">{{ app.user ? (app.user.displayName ?: app.user.userIdentifier)|first|upper : 'A' }}</span></summary>
                    <div class="bo-user-menu">
                        {% if app.user %}
                            <div class="who"><strong>{{ app.user.displayName }}</strong><span>{{ app.user.userIdentifier }}</span></div>
                        {% endif %}
                        {% if is_granted('articles.write') %}<a href="{{ path('admin_profile') }}">Mon profil d'auteur</a>{% endif %}
                        <a href="{{ path('admin_account_password') }}">Changer mon mot de passe</a>
                    </div>
                </details>
            </div>
        </header>

        <div class="bo-body-row">
            <aside class="bo-sidebar" id="bo-sidebar" aria-label="Menu de l'administration">
                <div class="bo-drawer-head">
                    <span class="bo-topbar-brand"><span class="mark">BB</span> Menu</span>
                    <button type="button" class="bo-icon-btn" data-drawer-close aria-label="Fermer le menu">
                        <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                {% if is_granted('articles.write') %}
                    <a href="{{ path('admin_article_new') }}" class="bo-new-btn">
                        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                        <span class="bo-label">Nouvel article</span>
                    </a>
                {% endif %}
                {{ include('admin/_sidebar_nav.html.twig') }}
                <div class="bo-drawer-site">
                    <a href="{{ path('app_home') }}" class="bo-nav-link">
                        <svg viewBox="0 0 24 24"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
                        <span class="bo-label">Voir le site</span>
                    </a>
                </div>
                <button type="button" class="bo-sidebar-collapse" id="bo-sidebar-toggle" title="Réduire la barre latérale">
                    <svg viewBox="0 0 24 24"><path d="M11 6 5 12l6 6"/><path d="M18 6l-6 6 6 6"/></svg>
                </button>
            </aside>
            <div class="bo-backdrop" data-drawer-close aria-hidden="true"></div>

            <main class="bo-content">
                {% for label, messages in app.flashes(['success', 'error', 'info']) %}
                    {% for message in messages %}
                        <div class="bo-flash bo-flash-{{ label }}" role="{{ label == 'error' ? 'alert' : 'status' }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                {% block admin_body %}{% endblock %}
            </main>
        </div>

        {# Barre d'onglets mobile (≤720px) : raccourcis à portée de pouce,
           le reste du menu s'ouvre dans le tiroir via « Menu ». #}
        {% set tabRoute = app.request.attributes.get('_route') ?? '' %}
        <nav class="bo-tabbar" aria-label="Navigation rapide">
            <a href="{{ path('admin_dashboard') }}" class="bo-tab {{ tabRoute starts with 'admin_dashboard' ? 'active' : '' }}">
                <svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9"/></svg>
                Accueil
            </a>
            {% if is_granted('articles.write') %}
                <a href="{{ path('admin_article_index') }}" class="bo-tab {{ tabRoute starts with 'admin_article' and tabRoute != 'admin_article_new' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24"><path d="M7 3h7l5 5v11a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 16.5h6M9 9.5h2"/></svg>
                    Articles
                </a>
                <a href="{{ path('admin_article_new') }}" class="bo-tab bo-tab-new {{ tabRoute == 'admin_article_new' ? 'active' : '' }}" aria-label="Nouvel article">
                    <span class="bo-tab-fab"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span>
                    Nouveau
                </a>
            {% endif %}
            {% if is_granted('stats.view') %}
                <a href="{{ path('admin_stats_index') }}" class="bo-tab {{ tabRoute starts with 'admin_stats' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24"><path d="M4 20V10M11 20V4M18 20v-7"/></svg>
                    Stats
                </a>
            {% endif %}
            <button type="button" class="bo-tab" data-drawer-open aria-controls="bo-sidebar" aria-expanded="false">
                <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                Menu
            </button>
        </nav>
    </div>

    <script>
        (function () {
            var app = document.getElementById('bo-app');
            var toggle = document.getElementById('bo-sidebar-toggle');
            // Sections repliables du menu : la section de la page courante est
            // ouverte par le serveur ; les autres reprennent l'état mémorisé.
            // Sidebar réduite (icônes seules) : tout est déplié pour que chaque
            // icône reste accessible, sans toucher à l'état mémorisé.
            var groups = Array.prototype.slice.call(document.querySelectorAll('.bo-nav-group'));
            var saved = {};
            try { saved = JSON.parse(localStorage.getItem('bo-nav-groups') || '{}') || {}; } catch (e) {}
            var compactQuery = window.matchMedia ? window.matchMedia('(max-width: 900px)') : null;
            var mobileQuery = window.matchMedia ? window.matchMedia('(max-width: 720px)') : null;
            function isMobile() { return !!(mobileQuery && mobileQuery.matches); }
            // Mode icônes seules (repli manuel ou tablette). Sur mobile, le menu
            // s'affiche en entier dans le tiroir : sections repliables normales.
            function isCompact() {
                if (isMobile()) return false;
                return (app && app.classList.contains('bo-collapsed')) || (compactQuery && compactQuery.matches);
            }
            function applyGroups() {
                groups.forEach(function (g) {
                    var key = g.getAttribute('data-nav-group');
                    g.setAttribute('data-silent', '1');
                    g.open = isCompact() || g.hasAttribute('data-active') || saved[key] === true;
                });
                window.setTimeout(function () { groups.forEach(function (g) { g.removeAttribute('data-silent'); }); }, 0);
            }
            groups.forEach(function (g) {
                g.addEventListener('toggle', function () {
                    if (g.hasAttribute('data-silent') || isCompact()) return;
                    saved[g.getAttribute('data-nav-group')] = g.open;
                    try { localStorage.setItem('bo-nav-groups', JSON.stringify(saved)); } catch (e) {}
                });
            });
            if (compactQuery && compactQuery.addEventListener) compactQuery.addEventListener('change', applyGroups);
            if (mobileQuery && mobileQuery.addEventListener) mobileQuery.addEventListener('change', function () {
                if (!isMobile()) setDrawer(false);
                applyGroups();
            });

            // Tiroir de navigation mobile.
            var sidebar = document.getElementById('bo-sidebar');
            var openers = Array.prototype.slice.call(document.querySelectorAll('[data-drawer-open]'));
            var lastOpener = null;
            function setDrawer(open) {
                if (!app) return;
                var wasOpen = app.classList.contains('bo-drawer-open');
                app.classList.toggle('bo-drawer-open', open);
                document.body.classList.toggle('bo-noscroll', open);
                openers.forEach(function (b) { b.setAttribute('aria-expanded', open ? 'true' : 'false'); });
                if (open) {
                    var closeBtn = sidebar && sidebar.querySelector('[data-drawer-close]');
                    if (closeBtn) closeBtn.focus({ preventScroll: true });
                } else if (wasOpen && lastOpener) {
                    lastOpener.focus({ preventScroll: true });
                }
            }
            openers.forEach(function (b) {
                b.addEventListener('click', function () { lastOpener = b; setDrawer(true); });
            });
            document.querySelectorAll('[data-drawer-close]').forEach(function (el) {
                el.addEventListener('click', function () { setDrawer(false); });
            });
            if (sidebar) sidebar.addEventListener('click', function (e) {
                if (e.target.closest && e.target.closest('a[href]')) { lastOpener = null; setDrawer(false); }
            });
            if (app) {
                app.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && app.classList.contains('bo-drawer-open')) setDrawer(false);
                });
                // Clavier virtuel ouvert : on masque la barre d'onglets du bas
                // pour libérer l'écran ; la barre d'actions du formulaire descend.
                var typingTimer = null;
                function isTextField(el) {
                    if (!el || !el.tagName) return false;
                    if (el.isContentEditable || el.tagName === 'TEXTAREA') return true;
                    return el.tagName === 'INPUT' && !/^(checkbox|radio|file|button|submit|reset|hidden|range|color)$/i.test(el.type);
                }
                app.addEventListener('focusin', function (e) {
                    if (!isMobile() || !isTextField(e.target)) return;
                    window.clearTimeout(typingTimer);
                    app.classList.add('bo-typing');
                });
                app.addEventListener('focusout', function () {
                    typingTimer = window.setTimeout(function () {
                        if (!isTextField(document.activeElement)) app.classList.remove('bo-typing');
                    }, 120);
                });
            }
            // Turbo garde une capture de la page pour le retour arrière : on
            // la prend tiroir fermé. Écouteur posé une seule fois par document.
            if (!window.boDrawerCacheHook) {
                window.boDrawerCacheHook = true;
                document.addEventListener('turbo:before-cache', function () {
                    var a = document.getElementById('bo-app');
                    if (a) a.classList.remove('bo-drawer-open', 'bo-typing');
                    document.body.classList.remove('bo-noscroll');
                });
            }

            // Tableaux en cartes sur mobile : chaque cellule reçoit l'intitulé
            // de sa colonne (data-label, affiché par le CSS), la cellule titre
            // passe en tête de carte et la cellule d'actions en pied de carte.
            // Un tableau sans <thead> ou marqué data-no-stack reste un tableau.
            document.querySelectorAll('table.bo-table').forEach(function (table) {
                if (table.hasAttribute('data-no-stack') || !table.tHead || !table.tHead.rows.length) return;
                var labels = Array.prototype.map.call(table.tHead.rows[0].cells, function (th) { return th.textContent.trim(); });
                table.classList.add('bo-stack');
                Array.prototype.forEach.call(table.tBodies, function (tbody) {
                    Array.prototype.forEach.call(tbody.rows, function (row) {
                        var cells = Array.prototype.slice.call(row.cells);
                        if (cells.length === 1) { cells[0].setAttribute('data-full', ''); return; }
                        var title = null;
                        cells.forEach(function (cell, i) {
                            cell.setAttribute('data-label', labels[i] || '');
                            var text = cell.textContent.replace(/\s+/g, ' ').trim();
                            if ((text === '' || text === '—') && !cell.querySelector('img, input:not([type=hidden]), button, select, svg')) {
                                cell.setAttribute('data-empty', '');
                            }
                            if (!title && cell.querySelector('.bo-row-title')) title = cell;
                        });
                        var last = cells[cells.length - 1];
                        if (last.querySelector('.bo-btn, button, form')) last.setAttribute('data-actions', '');
                        if (!title) {
                            for (var i = 0; i < cells.length; i++) {
                                if (cells[i] === last && last.hasAttribute('data-actions')) break;
                                if (!/^(ordre|type|#)$/i.test(labels[i] || '')) { title = cells[i]; break; }
                            }
                        }
                        if (title) { title.setAttribute('data-title', ''); title.removeAttribute('data-empty'); }
                    });
                });
            });

            if (toggle && app) {
                if (localStorage.getItem('bo-sidebar-collapsed') === '1') app.classList.add('bo-collapsed');
                toggle.addEventListener('click', function () {
                    app.classList.toggle('bo-collapsed');
                    localStorage.setItem('bo-sidebar-collapsed', app.classList.contains('bo-collapsed') ? '1' : '0');
                    applyGroups();
                });
            }
            applyGroups();

            // Generic client-side search + pill filtering for admin list tables.
            // Expects: a <table class="bo-table"> whose rows carry a data-search
            // attribute (haystack text) and, optionally, data-filter (category
            // key matched against .bo-pill[data-filter] buttons in the toolbar).
            document.querySelectorAll('[data-list-root]').forEach(function (root) {
                var rows = Array.prototype.slice.call(root.querySelectorAll('tbody tr'));
                var searchInput = root.querySelector('[data-list-search]');
                var pills = Array.prototype.slice.call(root.querySelectorAll('.bo-pill'));
                var activeFilter = 'all';

                function apply() {
                    var term = searchInput ? searchInput.value.trim().toLowerCase() : '';
                    rows.forEach(function (row) {
                        var matchesSearch = !term || (row.getAttribute('data-search') || '').toLowerCase().indexOf(term) !== -1;
                        var filterValues = (row.getAttribute('data-filter') || '').split(/\s+/);
                        var matchesFilter = activeFilter === 'all' || filterValues.indexOf(activeFilter) !== -1;
                        row.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
                    });
                }

                if (searchInput) searchInput.addEventListener('input', apply);
                pills.forEach(function (pill) {
                    pill.addEventListener('click', function () {
                        pills.forEach(function (p) { p.classList.remove('active'); });
                        pill.classList.add('active');
                        activeFilter = pill.getAttribute('data-filter') || 'all';
                        apply();
                    });
                });
            });

            // Generic multi-step wizard for create/edit forms (.bo-wizard).
            document.querySelectorAll('.bo-wizard').forEach(function (wizard) {
                var steps = Array.prototype.slice.call(wizard.querySelectorAll('.bo-step'));
                var tabs = Array.prototype.slice.call(wizard.querySelectorAll('.bo-stepper-tab'));
                var current = 0;

                function show(index) {
                    current = Math.max(0, Math.min(index, steps.length - 1));
                    steps.forEach(function (step, i) { step.style.display = i === current ? '' : 'none'; });
                    tabs.forEach(function (tab, i) {
                        tab.classList.toggle('active', i === current);
                        tab.classList.toggle('done', i < current);
                    });
                    wizard.querySelectorAll('[data-step-prev]').forEach(function (b) { b.style.display = current === 0 ? 'none' : ''; });
                    wizard.querySelectorAll('[data-step-next]').forEach(function (b) { b.style.display = current === steps.length - 1 ? 'none' : ''; });
                    wizard.querySelectorAll('[data-step-submit]').forEach(function (b) { b.style.display = current === steps.length - 1 ? '' : 'none'; });
                    if (current === steps.length - 1) buildReview();
                }

                function buildReview() {
                    var target = wizard.querySelector('[data-review]');
                    if (!target) return;
                    target.textContent = '';
                    steps.forEach(function (step, i) {
                        if (i === steps.length - 1) return;
                        step.querySelectorAll('.bo-form-row').forEach(function (row) {
                            var label = row.querySelector('label');
                            var field = row.querySelector('input:not([type=file]):not([data-controller~="rich-text"]), select, textarea:not([data-controller~="rich-text"])');
                            if (!label || !field) return;
                            var value;
                            if (field.tagName === 'SELECT') {
                                value = Array.prototype.slice.call(field.selectedOptions).map(function (o) { return o.text; }).join(', ');
                            } else if (field.type === 'checkbox') {
                                value = field.checked ? 'Oui' : 'Non';
                            } else {
                                value = field.value;
                            }
                            var line = document.createElement('div');
                            line.className = 'bo-review-row';
                            var span = document.createElement('span');
                            span.textContent = label.textContent;
                            var strong = document.createElement('strong');
                            strong.textContent = value || '—';
                            line.appendChild(span);
                            line.appendChild(strong);
                            target.appendChild(line);
                        });
                    });
                }

                wizard.querySelectorAll('[data-step-next]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var fields = steps[current].querySelectorAll('input, select, textarea');
                        for (var i = 0; i < fields.length; i++) {
                            if (!fields[i].checkValidity()) { fields[i].reportValidity(); return; }
                        }
                        show(current + 1);
                    });
                });
                wizard.querySelectorAll('[data-step-prev]').forEach(function (btn) {
                    btn.addEventListener('click', function () { show(current - 1); });
                });
                tabs.forEach(function (tab, i) {
                    tab.addEventListener('click', function () {
                        if (i <= current) { show(i); return; }
                        for (var s = current; s < i; s++) {
                            var fields = steps[s].querySelectorAll('input, select, textarea');
                            for (var f = 0; f < fields.length; f++) {
                                if (!fields[f].checkValidity()) { fields[f].reportValidity(); return; }
                            }
                        }
                        show(i);
                    });
                });

                show(0);
            });
        })();
    </script>
{% endblock %}
