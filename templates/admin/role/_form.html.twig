{{ form_start(form) }}
    <div class="bo-wizard-head">
        <div>
            <p class="bo-wizard-title">{{ heading }}</p>
        </div>
        <a href="{{ path('admin_role_index') }}" class="bo-wizard-close" title="Fermer">✕</a>
    </div>

    {{ form_errors(form) }}

    <div class="bo-step" style="max-width:760px">
        <div class="bo-form-row">{{ form_row(form.label) }}</div>
        <div class="bo-form-row">{{ form_row(form.description) }}</div>

        {% if form.permissions is defined %}
            <div class="bo-form-row">
                <label>Permissions</label>
                <p class="bo-muted" style="font-size:12.5px;margin:0 0 12px">Cochez ce que ce rôle permet de faire. Les permissions grisées sont celles que vous ne possédez pas : vous ne pouvez pas les accorder.</p>

                {# Les choix sont déjà rangés par groupe (Permission::grouped()). #}
                {% for group, permissions in groups %}
                    <fieldset style="border:1px solid var(--sp-border);border-radius:10px;padding:12px 16px 4px;margin:0 0 14px">
                        <legend style="font-weight:800;font-size:11.5px;text-transform:uppercase;letter-spacing:.4px;color:var(--sp-muted);padding:0 6px">{{ group }}</legend>
                        {% for choice in form.permissions %}
                            {% if choice.vars.value in permissions|map(p => p.value) %}
                                <label style="display:flex;align-items:center;gap:8px;font-weight:600;margin:0 0 10px;{{ choice.vars.attr.disabled is defined ? 'opacity:.5' : '' }}">
                                    {{ form_widget(choice) }}
                                    <span>{{ choice.vars.label }}</span>
                                </label>
                            {% endif %}
                        {% endfor %}
                    </fieldset>
                {% endfor %}
                {{ form_errors(form.permissions) }}
            </div>
            {% do form.permissions.setRendered %}
        {% else %}
            <div class="bo-flash" style="background:#eef6ff;color:#1e4e8c">Le rôle Administrateur a toutes les permissions : elles ne se modifient pas.</div>
        {% endif %}
    </div>

    {{ form_rest(form) }}

    <div class="bo-wizard-footer">
        <span></span>
        <div style="display:flex;gap:10px">
            <a href="{{ path('admin_role_index') }}" class="bo-btn bo-btn-muted">Annuler</a>
            <button type="submit" class="bo-btn bo-btn-accent">Enregistrer</button>
        </div>
    </div>
{{ form_end(form) }}
