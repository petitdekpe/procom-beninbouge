{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Rôles et permissions{% endblock %}

{% block admin_body %}
    <div class="bo-page-head">
        <h1 class="bo-page-title">Rôles et permissions</h1>
        <div style="display:flex;gap:10px">
            {% if is_granted('users.manage') %}
                <a href="{{ path('admin_user_index') }}" class="bo-btn bo-btn-muted">Utilisateurs</a>
            {% endif %}
            <a href="{{ path('admin_role_new') }}" class="bo-btn bo-btn-accent">+ Nouveau rôle</a>
        </div>
    </div>
    <p class="bo-muted" style="margin:-8px 0 20px">Un rôle regroupe des permissions ; un utilisateur cumule celles de tous ses rôles. Les quatre rôles système se règlent mais ne se suppriment pas, et l'administrateur a toujours toutes les permissions. Vous ne pouvez accorder que des permissions que vous possédez.</p>

    <div class="bo-card" style="margin-bottom:26px">
        <table class="bo-table">
            <thead>
                <tr><th>Rôle</th><th>Code</th><th>Permissions</th><th>Utilisateurs</th><th style="text-align:right">Actions</th></tr>
            </thead>
            <tbody>
                {% for role in roles %}
                    <tr>
                        <td>
                            <div style="font-weight:700">{{ role.label }}{% if role.system %} <span class="bo-format-badge" style="margin-left:6px;text-transform:none">Système</span>{% endif %}</div>
                            {% if role.description %}<div class="bo-muted" style="font-size:12.5px;max-width:380px">{{ role.description }}</div>{% endif %}
                        </td>
                        <td class="bo-muted" style="font-family:Consolas,Menlo,monospace;font-size:12.5px">{{ role.code }}</td>
                        <td class="bo-muted">{{ role.admin ? 'Toutes' : role.permissions|length ~ ' / ' ~ (groups|reduce((carry, list) => carry + list|length, 0)) }}</td>
                        <td class="bo-muted">{{ counts[role.code]|default(0) }}</td>
                        <td style="text-align:right;white-space:nowrap">
                            <a href="{{ path('admin_role_edit', { id: role.id }) }}" class="bo-btn bo-btn-muted">{{ role.admin ? 'Voir' : 'Modifier' }}</a>
                            {% if not role.system %}
                                <form method="post" action="{{ path('admin_role_delete', { id: role.id }) }}" style="display:inline" onsubmit="return confirm('Supprimer ce rôle ? Il sera retiré des comptes qui le portent.');">
                                    <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                    <button type="submit" class="bo-btn bo-btn-danger">Supprimer</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <h2 style="font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:var(--sp-muted);margin:0 0 10px">Vue d'ensemble</h2>
    <div class="bo-card" style="overflow-x:auto">
        <table class="bo-table">
            <thead>
                <tr>
                    <th>Permission</th>
                    {% for role in roles %}<th style="text-align:center;white-space:nowrap">{{ role.label }}</th>{% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for group, permissions in groups %}
                    <tr><td colspan="{{ roles|length + 1 }}" style="background:#fafafa;font-weight:800;font-size:11.5px;text-transform:uppercase;letter-spacing:.4px;color:var(--sp-muted)">{{ group }}</td></tr>
                    {% for permission in permissions %}
                        <tr>
                            <td>{{ permission.label }}</td>
                            {% for role in roles %}
                                <td style="text-align:center">{% if role.hasPermission(permission) %}<span style="color:#0b6b32;font-weight:900" title="Accordée">✓</span>{% else %}<span class="bo-muted">·</span>{% endif %}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
