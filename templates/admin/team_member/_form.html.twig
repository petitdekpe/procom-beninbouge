{{ form_start(form, { attr: { class: 'bo-wizard' } }) }}
    <div class="bo-wizard-head">
        <div>
            <p class="bo-wizard-title">{{ heading }}</p>
            <div class="bo-stepper">
                <button type="button" class="bo-stepper-tab">Identité</button>
                <span class="bo-stepper-sep">›</span>
                <button type="button" class="bo-stepper-tab">Présentation</button>
                <span class="bo-stepper-sep">›</span>
                <button type="button" class="bo-stepper-tab">Réseaux</button>
                <span class="bo-stepper-sep">›</span>
                <button type="button" class="bo-stepper-tab">Vérifier</button>
            </div>
        </div>
        <a href="{{ path('admin_team_member_index') }}" class="bo-wizard-close" title="Fermer">✕</a>
    </div>

    <div class="bo-step">
        <div class="bo-form-row">{{ form_row(form.fullName) }}</div>
        <div class="bo-form-row">{{ form_row(form.role) }}</div>
        {% if member.photo %}
            <div class="bo-form-row">
                <img src="{{ member.photo }}" alt="Photo actuelle" style="width:96px;height:96px;border-radius:50%;object-fit:cover;display:block">
            </div>
        {% endif %}
        <div class="bo-form-row">{{ form_row(form.photo) }}</div>
        <div class="bo-form-row">{{ form_row(form.photoFile) }}</div>
    </div>

    <div class="bo-step">
        <div class="bo-form-row">{{ form_row(form.bio) }}</div>
        <div class="bo-form-row">{{ form_row(form.visible) }}</div>
    </div>

    <div class="bo-step">
        <div class="bo-form-row">{{ form_row(form.email) }}</div>
        <div class="bo-form-row">{{ form_row(form.linkedinUrl) }}</div>
        <div class="bo-form-row">{{ form_row(form.twitterUrl) }}</div>
        <div class="bo-form-row">{{ form_row(form.facebookUrl) }}</div>
    </div>

    <div class="bo-step">
        <h2 style="font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:var(--sp-muted);margin:0 0 4px">Récapitulatif</h2>
        <div data-review></div>
    </div>

    {{ form_rest(form) }}

    <div class="bo-wizard-footer">
        <button type="button" class="bo-btn bo-btn-muted" data-step-prev>← Précédent</button>
        <div style="display:flex;gap:10px">
            <a href="{{ path('admin_team_member_index') }}" class="bo-btn bo-btn-muted">Annuler</a>
            <button type="button" class="bo-btn bo-btn-black" data-step-next>Suivant</button>
            <button type="submit" class="bo-btn bo-btn-accent" data-step-submit>Enregistrer</button>
        </div>
    </div>
{{ form_end(form) }}
