{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Utilisateurs{% endblock %}

{% block admin_body %}
    <div class="bo-page-head">
        <h1 class="bo-page-title">Utilisateurs</h1>
        <div style="display:flex;gap:10px">
            {% if is_granted('roles.manage') %}
                <a href="{{ path('admin_role_index') }}" class="bo-btn bo-btn-muted">Rôles et permissions</a>
            {% endif %}
            <a href="{{ path('admin_user_new') }}" class="bo-btn bo-btn-accent">+ Nouvel utilisateur</a>
        </div>
    </div>
    <p class="bo-muted" style="margin:-8px 0 20px">À la création d'un compte, un mot de passe temporaire est envoyé par e-mail : la personne devra choisir le sien dès sa première connexion. Ce que chaque rôle permet de faire se règle dans « Rôles et permissions ».</p>

    <div data-list-root>
        <div class="bo-toolbar">
            <div class="bo-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-3.8-3.8"/></svg>
                <input type="text" data-list-search placeholder="Rechercher un utilisateur">
            </div>
        </div>

        <div class="bo-card">
            <table class="bo-table">
                <thead>
                    <tr><th>Compte</th><th>Rôles</th><th>Statut</th><th style="text-align:right">Actions</th></tr>
                </thead>
                <tbody>
                    {% for u in users %}
                        {% set isSelf = u == app.user %}
                        {% set isAdminUser = 'ROLE_ADMIN' in u.roles %}
                        {% set locked = isAdminUser and not is_granted('ROLE_ADMIN') %}
                        <tr data-search="{{ (u.displayName ~ ' ' ~ u.email)|lower }}">
                            <td>
                                <div style="font-weight:700">{{ u.displayName }}{% if isSelf %} <span class="bo-muted" style="font-weight:600">(vous)</span>{% endif %}</div>
                                <div class="bo-muted" style="font-size:12.5px">{{ u.email }}</div>
                            </td>
                            <td>
                                {% set shown = 0 %}
                                {% for role in u.roles %}
                                    {% if role != 'ROLE_READER' %}
                                        {% set shown = shown + 1 %}
                                        <span class="bo-format-badge" style="margin:0 4px 4px 0;text-transform:none;white-space:nowrap">{{ roleLabels[role]|default(role) }}</span>
                                    {% endif %}
                                {% endfor %}
                                {% if shown == 0 %}<span class="bo-muted">Lecteur</span>{% endif %}
                            </td>
                            <td>
                                {% if not u.enabled %}
                                    <span class="bo-status"><span class="dot" style="background:var(--sp-gray-dot)"></span>Désactivé</span>
                                {% elseif u.mustChangePassword %}
                                    <span class="bo-status"><span class="dot" style="background:var(--sp-amber)"></span>Mot de passe temporaire</span>
                                {% else %}
                                    <span class="bo-status"><span class="dot" style="background:var(--sp-green)"></span>Actif</span>
                                {% endif %}
                            </td>
                            <td><div class="bo-actions">
                                {% if locked %}
                                    <span class="bo-muted" style="font-size:12.5px">Réservé aux administrateurs</span>
                                {% else %}
                                    <a href="{{ path('admin_user_edit', { id: u.id }) }}" class="bo-btn bo-btn-sm bo-btn-muted">Modifier</a>
                                    <form method="post" action="{{ path('admin_user_reset_password', { id: u.id }) }}" onsubmit="return confirm('Générer un nouveau mot de passe temporaire et l\'envoyer par e-mail à {{ u.email|e('js') }} ? L\'ancien mot de passe ne fonctionnera plus.');">
                                        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                        <button type="submit" class="bo-btn bo-btn-sm bo-btn-muted">Nouveau mot de passe</button>
                                    </form>
                                    {% if not isSelf %}
                                        <form method="post" action="{{ path('admin_user_toggle', { id: u.id }) }}" style="display:inline">
                                            <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                            <button type="submit" class="bo-btn bo-btn-sm bo-btn-muted">{{ u.enabled ? 'Désactiver' : 'Réactiver' }}</button>
                                        </form>
                                        <form method="post" action="{{ path('admin_user_delete', { id: u.id }) }}" onsubmit="return confirm('Supprimer définitivement ce compte ?');">
                                            <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                            <button type="submit" class="bo-btn bo-btn-sm bo-btn-danger">Supprimer</button>
                                        </form>
                                    {% endif %}
                                {% endif %}
                            </div></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
