{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Correction{% endblock %}

{% block admin_body %}
    <div class="bo-page-head">
        <h1 class="bo-page-title">✅ Correction</h1>
    </div>
    <p class="bo-muted" style="margin-bottom:18px">Articles approuvés par le rédacteur en chef, en attente de correction. Validez pour publier (immédiatement ou à une date programmée), ou refusez avec un motif pour les renvoyer au journaliste.</p>

    <div class="bo-card">
        {% if articles|length > 0 %}
            <table class="bo-table">
                <thead>
                    <tr><th>Titre</th><th>Auteur</th><th>Catégorie</th><th></th></tr>
                </thead>
                <tbody>
                    {% for article in articles %}
                        <tr>
                            <td style="font-weight:700">
                                <a href="{{ path('admin_article_edit', { id: article.id }) }}" class="bo-h">{{ article.title }}</a>
                            </td>
                            <td class="bo-muted">{{ article.author ? article.author.firstName ~ ' ' ~ article.author.lastName : '—' }}</td>
                            <td class="bo-muted">{{ article.category ? article.category.name : '—' }}</td>
                            <td style="text-align:right;white-space:nowrap">
                                <button type="button" class="bo-btn bo-btn-accent" data-validate-toggle="validate-{{ article.id }}">Valider</button>
                                <button type="button" class="bo-btn bo-btn-danger" data-reject-toggle="correction-{{ article.id }}">Refuser</button>
                            </td>
                        </tr>
                        <tr id="validate-{{ article.id }}" class="bo-reject-row" hidden>
                            <td colspan="4">
                                <form method="post" action="{{ path('admin_workflow_correction_validate', { id: article.id }) }}" style="display:flex;gap:14px;align-items:center;padding:8px 0;flex-wrap:wrap">
                                    <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                    <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700">
                                        <input type="radio" name="mode" value="now" checked> Publier maintenant
                                    </label>
                                    <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700">
                                        <input type="radio" name="mode" value="schedule"> Programmer pour :
                                    </label>
                                    <input type="datetime-local" name="publish_at" style="padding:7px;border-radius:8px;border:1px solid var(--sp-border)">
                                    <button type="submit" class="bo-btn bo-btn-accent">Confirmer</button>
                                </form>
                            </td>
                        </tr>
                        <tr id="correction-{{ article.id }}" class="bo-reject-row" hidden>
                            <td colspan="4">
                                <form method="post" action="{{ path('admin_workflow_correction_reject', { id: article.id }) }}" style="display:flex;gap:8px;align-items:flex-start;padding:8px 0">
                                    <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                    <textarea name="reason" required placeholder="Motif du refus (obligatoire, visible par le journaliste)" rows="2" style="flex:1;padding:8px;border-radius:8px;border:1px solid var(--sp-border)"></textarea>
                                    <button type="submit" class="bo-btn bo-btn-danger">Confirmer le refus</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="bo-empty">Aucun article en attente de correction.</p>
        {% endif %}
    </div>

    <script>
        document.querySelectorAll('[data-reject-toggle], [data-validate-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var targetId = btn.getAttribute('data-reject-toggle') || btn.getAttribute('data-validate-toggle');
                var row = document.getElementById(targetId);
                row.hidden = !row.hidden;
            });
        });
    </script>
{% endblock %}
