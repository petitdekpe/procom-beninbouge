{# Lecteur vidéo vertical (9:16) d'un article Récap : lien YouTube (Short
   compris) en iframe, ou fichier mp4/webm en <video> natif avec la
   couverture comme affiche. Styles : .bb-recap-player* dans assets/styles/content.css.
   Attend : article (App\Entity\Article avec vidéo lisible). #}
<div class="bb-recap-player">
    {% if article.videoYoutubeId %}
        <iframe src="{{ article.videoEmbedSrc }}"
                title="{{ article.title }}"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
                loading="eager"></iframe>
    {% else %}
        <video controls playsinline preload="metadata"{% if article.coverImage %} poster="{{ article.coverImage }}"{% endif %}>
            <source src="{{ article.videoFileUrl }}">
            Votre navigateur ne peut pas lire cette vidéo.
        </video>
    {% endif %}
</div>
