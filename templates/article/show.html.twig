{% extends 'base.html.twig' %}

{% set articleUrl = url('app_article_show', { slug: article.slug }) %}
{% set metaDescription = (article.metaDescription ?: article.content)|excerpt(180) %}

{% block title %}{{ article.metaTitle ?: article.title }} | {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: article.metaTitle ?: article.title,
        metaDescription: metaDescription,
        canonicalUrl: articleUrl,
        ogType: 'article',
        ogImage: article.coverImage,
        structuredData: article.structuredData,
    }) }}
    {% if article.status.value != 'published' %}<meta name="robots" content="noindex, nofollow">{% endif %}
{% endblock %}

{% block body %}
{% set shareLinks = [
    { channel: 'facebook', label: 'Partager sur Facebook', href: 'https://www.facebook.com/sharer/sharer.php?u=' ~ articleUrl|url_encode,
      icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>' },
    { channel: 'twitter', label: 'Partager sur X', href: 'https://twitter.com/intent/tweet?url=' ~ articleUrl|url_encode ~ '&text=' ~ article.title|url_encode,
      icon: '<path fill="currentColor" stroke="none" d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77zm-1.08 16.18h1.7L7.4 4.73H5.58z"/>' },
    { channel: 'whatsapp', label: 'Partager sur WhatsApp', href: 'https://wa.me/?text=' ~ (article.title ~ ' ' ~ articleUrl)|url_encode,
      icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>' },
    { channel: 'linkedin', label: 'Partager sur LinkedIn', href: 'https://www.linkedin.com/sharing/share-offsite/?url=' ~ articleUrl|url_encode,
      icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>' },
] %}
<div{% if article.status.value == 'published' %}
     data-controller="article-tracker share-tracker"
     data-article-tracker-article-id-value="{{ article.id }}"
     data-share-tracker-article-id-value="{{ article.id }}"
    {%- endif %}>

    {% if article.status.value != 'published' %}
        {% set previewLabel = article.status.value == 'scheduled' ? 'Programmé · ' ~ (article.publishedAt ? article.publishedAt|date('d/m/Y à H:i') : '') : 'Brouillon' %}
        <div class="bb-preview-banner" role="status">
            Aperçu d'un article qui n'est pas encore public ({{ previewLabel }}). Seuls les comptes éditeurs et admin voient cette page.
        </div>
    {% endif %}

    {{ include('partials/_header.html.twig') }}

    <main id="contenu">
        <article class="bb-article">
            {# ===== EN-TÊTE ===== #}
            <header class="bb-container bb-article-head"{% if article.category %} style="--bb-cat:{{ article.category.color }}"{% endif %}>
                <nav class="bb-breadcrumb" aria-label="Fil d'Ariane">
                    <a href="{{ path('app_home') }}">Accueil</a>
                    {% if article.category %}
                        <span aria-hidden="true">/</span>
                        <a href="{{ path('app_category_show', { slug: article.category.slug }) }}">{{ article.category.name }}</a>
                    {% endif %}
                </nav>

                <div class="bb-article-chips">
                    {% if article.category %}
                        <a href="{{ path('app_category_show', { slug: article.category.slug }) }}" class="bb-chip"><span class="bb-dot" aria-hidden="true"></span>{{ article.category.name }}</a>
                    {% endif %}
                    {% if article.sponsored %}
                        <span class="bb-chip bb-chip--gold">Publi-reportage</span>
                    {% endif %}
                </div>

                <h1 class="bb-display bb-article-title">{{ article.title }}</h1>

                <div class="bb-article-meta">
                    <p class="bb-article-byline">
                        {% if article.author %}{{ include('partials/_author_avatar.html.twig', { author: article.author, class: 'bb-author-avatar bb-author-avatar--sm' }) }}<strong>{{ article.author.firstName }} {{ article.author.lastName }}</strong><span aria-hidden="true">·</span>{% endif %}
                        {% if article.publishedAt %}<time datetime="{{ article.publishedAt|date('c') }}">{{ article.publishedAt|french_date }}</time><span aria-hidden="true">·</span>{% endif %}
                        <span>{{ article.content|reading_time }} min de lecture</span>
                    </p>
                    <ul class="bb-share" aria-label="Partager l'article">
                        {% for share in shareLinks %}
                            <li>
                                <a href="{{ share.href }}" target="_blank" rel="noopener" class="bb-icon-btn bb-share-link" aria-label="{{ share.label }}" data-action="click->share-tracker#track" data-share-tracker-channel-param="{{ share.channel }}">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ share.icon|raw }}</svg>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </header>

            {% if article.coverImage %}
                <figure class="bb-container bb-article-cover">
                    <div class="bb-article-cover-frame">
                        <img src="{{ article.coverImage }}" alt="" fetchpriority="high">
                    </div>
                </figure>
            {% endif %}

            {# ===== CORPS ===== #}
            <div class="bb-container">
                <div class="bb-article-body bb-prose">{{ article.content|raw }}</div>

                <div class="bb-prose">
                    {% if article.documents|length > 0 %}
                        <section class="bb-docs" aria-labelledby="article-docs-title">
                            <h2 id="article-docs-title" class="bb-docs-title">Documents à télécharger</h2>
                            <ul class="bb-docs-list">
                                {% for document in article.documents %}
                                    <li>
                                        <a href="{{ path('app_document_download', { slug: document.slug }) }}" class="bb-doc" download>
                                            <span class="bb-doc-ext">{{ document.extension ?: 'DOC' }}</span>
                                            <span class="bb-doc-name">{{ document.name }}</span>
                                            {% if document.size is not null %}
                                                <span class="bb-doc-size">{% if document.size >= 1048576 %}{{ (document.size / 1048576)|number_format(1, ',', ' ') }} Mo{% else %}{{ (document.size / 1024)|round(0, 'ceil') }} Ko{% endif %}</span>
                                            {% endif %}
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </section>
                    {% endif %}

                    {% if article.tags|length > 0 %}
                        <ul class="bb-tags" aria-label="Mots-clés">
                            {% for tag in article.tags %}
                                <li><a href="{{ path('app_tag_show', { slug: tag.slug }) }}" class="bb-tag">#{{ tag.name }}</a></li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if article.author %}
                        <aside class="bb-author" aria-label="L'auteur">
                            {{ include('partials/_author_avatar.html.twig', { author: article.author, class: 'bb-author-avatar' }) }}
                            <div>
                                <p class="bb-author-name">{{ article.author.firstName }} {{ article.author.lastName }}</p>
                                {% if article.author.bio %}<p class="bb-author-bio">{{ article.author.bio }}</p>{% endif %}
                            </div>
                        </aside>
                    {% endif %}
                </div>
            </div>
        </article>

        {# ===== COMMENTAIRES ===== #}
        <section class="bb-container bb-comments" aria-labelledby="comments-title">
            <div class="bb-prose">
                {% for label, messages in app.flashes(['success', 'error']) %}
                    {% for message in messages %}
                        <div class="bb-alert {{ label == 'error' ? 'bb-alert-error' : 'bb-alert-success' }}" role="status">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                <h2 id="comments-title" class="bb-display bb-comments-title">
                    {{ comments|length }} commentaire{{ comments|length > 1 ? 's' : '' }}
                </h2>

                {% if comments|length > 0 %}
                    <ol class="bb-comment-list">
                        {% for comment in comments %}
                            <li class="bb-comment">
                                <p class="bb-comment-head"><strong>{{ comment.authorName }}</strong> <span>· {{ comment.createdAt|time_ago }}</span></p>
                                <p class="bb-comment-text">{{ comment.content }}</p>
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}

                {% if article.status.value == 'published' %}
                    <div class="bb-comment-form-card">
                        <h3 class="bb-comment-form-title">Laisser un commentaire</h3>
                        {{ form_start(commentForm, { action: path('app_comment_create', { slug: article.slug }), attr: { class: 'bb-comment-form' } }) }}
                            <div class="bb-field">
                                {{ form_label(commentForm.authorName, null, { label_attr: { class: 'bb-label' } }) }}
                                {{ form_widget(commentForm.authorName, { attr: { class: 'bb-input' } }) }}
                                {{ form_errors(commentForm.authorName) }}
                            </div>
                            <div class="bb-field">
                                {{ form_label(commentForm.authorEmail, null, { label_attr: { class: 'bb-label' } }) }}
                                {{ form_widget(commentForm.authorEmail, { attr: { class: 'bb-input' } }) }}
                                {{ form_errors(commentForm.authorEmail) }}
                            </div>
                            <div class="bb-field">
                                {{ form_label(commentForm.content, null, { label_attr: { class: 'bb-label' } }) }}
                                {{ form_widget(commentForm.content, { attr: { class: 'bb-input bb-textarea' } }) }}
                                {{ form_errors(commentForm.content) }}
                            </div>
                            <button type="submit" class="bb-btn bb-btn--cta">Envoyer</button>
                        {{ form_end(commentForm) }}
                    </div>
                {% endif %}
            </div>
        </section>

        {# ===== À LIRE AUSSI ===== #}
        {% if related|length > 0 %}
            <section class="bb-container bb-section--tight" aria-labelledby="related-title">
                <div class="bb-sec-head">
                    <h2 id="related-title" class="bb-display bb-h2">À lire aussi</h2>
                </div>
                <div class="bb-grid-3">
                    {% for a in related %}
                        {{ include('partials/_article_card.html.twig', { article: a }) }}
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </main>

    {{ include('partials/_footer.html.twig') }}
</div>
{% endblock %}
