{% extends 'base.html.twig' %}

{% set categoryUrl = url('app_category_show', { slug: category.slug }) %}
{% set categoryDescription = category.metaDescription ?: (category.description ? category.description|excerpt(160) : null) %}

{% block title %}{{ category.metaTitle ?: category.name }} | {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: (category.metaTitle ?: category.name) ~ ' | ' ~ site_settings().siteName,
        metaDescription: categoryDescription,
        canonicalUrl: categoryUrl,
        structuredData: {
            '@context': 'https://schema.org',
            '@type': 'CollectionPage',
            'name': category.metaTitle ?: category.name,
            'description': categoryDescription,
            'url': categoryUrl,
        },
    }) }}
{% endblock %}

{% block body %}
    {{ include('partials/_header.html.twig') }}

    <main id="contenu">
        {{ include('partials/_page_head.html.twig', {
            crumbs: (category.parent ? [{ label: category.parent.name, href: path('app_category_show', { slug: category.parent.slug }) }] : [])|merge([{ label: category.name }]),
            kicker: 'Rubrique',
            title: category.name,
            lead: category.description,
            meta: articles|length ~ ' article' ~ (articles|length > 1 ? 's' : '') ~ ' publié' ~ (articles|length > 1 ? 's' : ''),
            color: category.color,
        }) }}

        <section class="bb-container bb-section--tight" aria-label="Articles de la rubrique">
            {% if articles|length > 0 %}
                <div class="bb-grid-3" data-controller="impression-tracker" data-impression-tracker-context-value="category_page">
                    {% for article in articles %}
                        {{ include('partials/_article_card.html.twig', { article: article, headingLevel: 2 }) }}
                    {% endfor %}
                </div>
            {% else %}
                <p class="bb-empty">Aucun article publié dans cette rubrique pour le moment.</p>
            {% endif %}
        </section>

        {% if media|length > 0 %}
            {{ include('partials/_media_grid.html.twig', { media: media }) }}
        {% endif %}
    </main>

    {{ include('partials/_footer.html.twig') }}
{% endblock %}
