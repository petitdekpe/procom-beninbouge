{% extends 'base.html.twig' %}

{% set dossierIndexUrl = url('app_dossier_index') %}

{% block title %}Dossiers | {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:ital,wght@0,500;0,600;0,700;0,800;0,900;1,700;1,800;1,900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: 'Dossiers | ' ~ site_settings().siteName,
        metaDescription: 'Nos grandes enquêtes et sujets suivis dans la durée, tous leurs articles réunis au même endroit.',
        canonicalUrl: dossierIndexUrl,
    }) }}
{% endblock %}

{% block body %}
{% set gradientPalette = [
    'linear-gradient(140deg,#0E3F51,#2B6B43)',
    'linear-gradient(140deg,#CF3732,#a3140d)',
    'linear-gradient(140deg,#3a3f33,#14160F)',
    'linear-gradient(140deg,#3A8556,#1C4A2E)',
] %}

<div style="background:var(--bb-bg);color:#14160F;font-family:'Manrope',sans-serif">

    {{ include('partials/_header.html.twig') }}

    {# ===== EN-TÊTE PAGE ===== #}
    <section style="max-width:var(--bb-container);margin:0 auto;padding:54px 24px 10px">
        <div style="display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:#8a8a7c;margin-bottom:18px">
            <a href="{{ path('app_home') }}" style="text-decoration:none;color:#8a8a7c">Accueil</a>
            <span>/</span>
            <span style="color:#3a3f33">Dossiers</span>
        </div>
        <span style="display:inline-block;background:#0E3F51;color:#fff;font-weight:800;font-size:11.5px;letter-spacing:.5px;padding:7px 16px;border-radius:999px;text-transform:uppercase">Dossiers</span>
        <h1 style="font-family:'Archivo';font-weight:900;font-size:36px;color:#14160F;margin-top:16px;letter-spacing:-.4px">Les grands <em style="font-style:italic;color:#2B6B43">dossiers</em></h1>
        <p style="color:#51544a;font-size:15px;line-height:1.7;margin-top:12px;max-width:520px">Nos grandes enquêtes et sujets suivis dans la durée, tous leurs articles réunis au même endroit.</p>
    </section>

    {# ===== GRILLE DOSSIERS ===== #}
    <section style="max-width:var(--bb-container);margin:0 auto;padding:34px 24px 64px">
        {% if dossiers|length > 0 %}
        <div class="bb-grid-3" style="gap:24px">
            {% for dossier in dossiers %}
                <a href="{{ path('app_dossier_show', { slug: dossier.slug }) }}" class="bb-card" style="text-decoration:none;display:block;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 10px 26px -22px rgba(20,22,15,.55)">
                    <div style="position:relative;aspect-ratio:16/9;overflow:hidden">
                        <div class="bb-zoom" style="position:absolute;inset:0;{% if dossier.coverImage %}background:url('{{ dossier.coverImage }}') center/cover{% else %}background:{{ gradientPalette[loop.index0 % 4] }}{% endif %}"></div>
                        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(7,10,6,.55),transparent 55%)"></div>
                        <span style="position:absolute;bottom:12px;left:14px;color:#fff;font-weight:800;font-size:11px;letter-spacing:.4px;text-transform:uppercase">{{ dossier.articles|length }} article{{ dossier.articles|length > 1 ? 's' : '' }}</span>
                    </div>
                    <div style="padding:16px 16px 20px">
                        <h2 class="bb-h" style="font-family:'Archivo';font-weight:800;font-size:18px;line-height:1.25;color:#14160F">{{ dossier.title }}</h2>
                        {% if dossier.description %}<p style="color:#8a8a7c;font-size:13px;line-height:1.6;margin-top:8px">{{ dossier.description|excerpt(120) }}</p>{% endif %}
                    </div>
                </a>
            {% endfor %}
        </div>
        {% else %}
            <p class="bb-empty">Aucun dossier publié pour le moment.</p>
        {% endif %}
    </section>

    {{ include('partials/_footer.html.twig') }}

</div>
{% endblock %}
