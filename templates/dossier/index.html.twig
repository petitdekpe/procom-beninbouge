{% extends 'base.html.twig' %}

{% set dossierIndexUrl = url('app_dossier_index') %}

{% block title %}Dossiers | {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: 'Dossiers | ' ~ site_settings().siteName,
        metaDescription: 'Nos grandes enquêtes et sujets suivis dans la durée, tous leurs articles réunis au même endroit.',
        canonicalUrl: dossierIndexUrl,
    }) }}
{% endblock %}

{% block body %}
    {{ include('partials/_header.html.twig') }}

    <main id="contenu">
        {{ include('partials/_page_head.html.twig', {
            crumbs: [{ label: 'Dossiers' }],
            kicker: 'Dossiers',
            title: 'Les grands',
            accent: 'dossiers',
            lead: 'Nos grandes enquêtes et sujets suivis dans la durée, tous leurs articles réunis au même endroit.',
            color: '#CF3732',
        }) }}

        <section class="bb-container bb-section--tight" aria-label="Liste des dossiers">
            {% if dossiers|length > 0 %}
                <ul class="bb-grid-3 bb-dossier-grid">
                    {% for dossier in dossiers %}
                        {% set count = dossier.articles|length %}
                        <li>
                            <a href="{{ path('app_dossier_show', { slug: dossier.slug }) }}" class="bb-card-a">
                                <span class="bb-card-a-media bb-placeholder" style="--bb-cat:#0E3F51">
                                    {% if dossier.coverImage %}<img src="{{ dossier.coverImage }}" alt="" loading="lazy">{% endif %}
                                    <span class="bb-chip bb-chip--gold bb-card-a-chip">{{ count }} article{{ count > 1 ? 's' }}</span>
                                </span>
                                <div class="bb-card-a-body">
                                    <h2 class="bb-card-a-title">{{ dossier.title }}</h2>
                                    {% if dossier.description %}<p class="bb-card-a-excerpt">{{ dossier.description|excerpt(160) }}</p>{% endif %}
                                </div>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="bb-empty">Aucun dossier publié pour le moment.</p>
            {% endif %}
        </section>
    </main>

    {{ include('partials/_footer.html.twig') }}
{% endblock %}
