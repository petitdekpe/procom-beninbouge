{% extends 'base.html.twig' %}

{% set dossierUrl = url('app_dossier_show', { slug: dossier.slug }) %}
{% set dossierDescription = dossier.metaDescription ?: (dossier.description ? dossier.description|excerpt(180) : null) %}

{% block title %}{{ dossier.metaTitle ?: dossier.title }} | Dossier {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: dossier.metaTitle ?: dossier.title,
        metaDescription: dossierDescription,
        canonicalUrl: dossierUrl,
        ogImage: dossier.coverImage,
        structuredData: {
            '@context': 'https://schema.org',
            '@type': 'CollectionPage',
            'name': dossier.metaTitle ?: dossier.title,
            'description': dossierDescription,
            'url': dossierUrl,
        },
    }) }}
{% endblock %}

{% block body %}
    {{ include('partials/_header.html.twig') }}

    <main id="contenu">
        {# Bannière : couverture du dossier sous un voile noir-marque, titre en grand. #}
        <header class="bb-container bb-dossier-hero-wrap">
            <div class="bb-dossier-hero">
                <div class="bb-dossier-hero-media bb-placeholder" style="--bb-cat:#0E3F51">
                    {% if dossier.coverImage %}<img src="{{ dossier.coverImage }}" alt="">{% endif %}
                </div>
                <div class="bb-dossier-hero-text">
                    <nav class="bb-breadcrumb" aria-label="Fil d'Ariane">
                        <a href="{{ path('app_home') }}">Accueil</a>
                        <span aria-hidden="true">/</span>
                        <a href="{{ path('app_dossier_index') }}">Dossiers</a>
                    </nav>
                    <span class="bb-chip bb-chip--gold">Dossier</span>
                    <h1 class="bb-display bb-dossier-hero-title">{{ dossier.title }}</h1>
                    {% if dossier.description %}<p class="bb-dossier-hero-lead">{{ dossier.description }}</p>{% endif %}
                    <p class="bb-dossier-hero-meta">{{ articles|length }} article{{ articles|length > 1 ? 's' }} dans ce dossier</p>
                </div>
            </div>
        </header>

        <section class="bb-container bb-section--tight" aria-label="Articles du dossier">
            {% if articles|length > 0 %}
                <div class="bb-grid-3" data-controller="impression-tracker" data-impression-tracker-context-value="dossier_page">
                    {% for article in articles %}
                        {{ include('partials/_article_card.html.twig', { article: article, headingLevel: 2 }) }}
                    {% endfor %}
                </div>
            {% else %}
                <p class="bb-empty">Aucun article publié dans ce dossier pour le moment.</p>
            {% endif %}
        </section>
    </main>

    {{ include('partials/_footer.html.twig') }}
{% endblock %}
