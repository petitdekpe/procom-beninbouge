{% extends 'base.html.twig' %}

{% set homeSettings = site_settings() %}
{% set homeUrl = url('app_home') %}
{% set homeDescription = "Politique, économie, culture et initiatives locales : l'actualité béninoise vérifiée et racontée depuis le terrain." %}
{% set homeSameAs = [homeSettings.facebookUrl, homeSettings.twitterUrl, homeSettings.instagramUrl, homeSettings.youtubeUrl]|filter(u => u is not empty) %}

{% block title %}{{ homeSettings.siteName }} | L'actualité du Bénin qui bouge{% endblock %}

{% block stylesheets %}
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: homeSettings.siteName ~ ' | L\'actualité du Bénin qui bouge',
        metaDescription: homeDescription,
        canonicalUrl: homeUrl,
        structuredData: {
            '@context': 'https://schema.org',
            '@graph': [
                {
                    '@type': 'WebSite',
                    'name': homeSettings.siteName,
                    'url': homeUrl,
                },
                {
                    '@type': 'Organization',
                    'name': homeSettings.siteName,
                    'url': homeUrl,
                    'logo': homeSettings.logoUrl ? absolute_url(homeSettings.logoUrl) : absolute_url(asset('images/logo-benin-bouge-noir.png')),
                    'sameAs': homeSameAs,
                },
            ],
        },
    }) }}
{% endblock %}

{% block body %}
{# Accueil (charte 2026, V2). L'ordre et l'activation des sections restent
   pilotés par /admin/home-sections (App\Controller\HomeController,
   App\Entity\HomeSection) ; chaque type a son partial dans
   templates/partials/home_sections/. Une section sans contenu n'est pas
   affichée, et un article n'apparaît qu'une fois sur la page. #}
{% set enabledTypes = homeSections|map(s => s.type.value) %}
{% set uneEnabled = 'hero_slider' in enabledTypes %}
<div data-controller="video-modal">

    {{ include('partials/_header.html.twig') }}

    <main id="contenu">
        <h1 class="bb-sr-only">{{ homeSettings.siteName }}, l'actualité du Bénin qui bouge</h1>

        {{ include('partials/_ticker.html.twig', { items: ticker }) }}

        {% for section in homeSections %}
            {% if section.type.value == 'hero_slider' %}
                {{ include('partials/home_sections/_hero_slider.html.twig', { une: une, mostRead: mostRead, jobsCount: onlineAnnouncementsCount, jobsAnnouncement: jobsAnnouncement }) }}
            {% elseif section.type.value == 'banner' %}
                {{ include('partials/home_sections/_banner.html.twig', { banners: banners }) }}
            {% elseif section.type.value == 'latest_news' %}
                {{ include('partials/home_sections/_latest_news.html.twig', { fil: fil }) }}
            {% elseif section.type.value == 'popular_articles' and not uneEnabled %}
                {# Avec « La une », les plus lus sont déjà dans sa grille. #}
                {{ include('partials/home_sections/_popular_articles.html.twig', { popular: mostRead }) }}
            {% elseif section.type.value == 'recap' %}
                {{ include('partials/home_sections/_recap.html.twig', { recaps: recaps }) }}
            {% elseif section.type.value == 'videos' %}
                {{ include('partials/home_sections/_videos.html.twig', { videos: videos }) }}
            {% elseif section.type.value == 'podcasts' %}
                {{ include('partials/home_sections/_podcasts.html.twig', { podcasts: podcasts }) }}
            {% elseif section.type.value == 'announcements' %}
                {{ include('partials/home_sections/_announcements.html.twig', { announcements: homeAnnouncements, jobsCount: onlineAnnouncementsCount }) }}
            {% elseif section.type.value == 'contact' %}
                {{ include('partials/home_sections/_contact.html.twig') }}
            {% elseif section.type.value == 'category_highlight' and section.category %}
                {{ include('partials/home_sections/_category_highlight.html.twig', { category: section.category, articles: categoryHighlightArticles[section.id]|default([]) }) }}
            {% endif %}
        {% endfor %}

        {# La carte WhatsApp vit avec les podcasts ; sans section podcasts, elle s'affiche seule. #}
        {% if 'podcasts' not in enabledTypes and homeSettings.whatsappUrl %}
            {{ include('partials/home_sections/_podcasts.html.twig', { podcasts: [] }) }}
        {% endif %}
    </main>

    {{ include('partials/_video_modal.html.twig') }}

    {% if popupAnnouncements %}
        {{ include('partials/_announcement_popup.html.twig', { announcements: popupAnnouncements }) }}
    {% endif %}

    {{ include('partials/_footer.html.twig') }}

</div>
{% endblock %}
