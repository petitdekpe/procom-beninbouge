<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ settings.siteName }} — Maintenance</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body style="margin:0;background:#0E3F51;color:#fff;font-family:'Manrope',sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">
    <div style="max-width:520px;text-align:center">
        {% if settings.logoFooterUrl %}
            <img src="{{ settings.logoFooterUrl }}" alt="{{ settings.siteName }}" style="height:34px;width:auto;margin-bottom:28px">
        {% else %}
            <div style="font-family:'Archivo';font-weight:900;font-size:20px;margin-bottom:28px">{{ settings.siteName }}</div>
        {% endif %}
        <div style="font-size:40px;margin-bottom:16px">🛠️</div>
        <h1 style="font-family:'Archivo';font-weight:900;font-size:26px;margin:0 0 14px;letter-spacing:-.3px">Site en maintenance</h1>
        <p style="color:#cfd2c8;font-size:15px;line-height:1.6;margin:0">
            {{ settings.maintenanceMessage ?: "Le site est momentanément indisponible le temps d'une intervention. Merci de revenir un peu plus tard." }}
        </p>
    </div>
</body>
</html>
