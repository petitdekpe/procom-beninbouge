{% extends 'base.html.twig' %}

{% set pageUrl = url('app_page_show', { slug: page.slug }) %}
{% set metaDescription = page.metaDescription|excerpt(180) %}

{% block title %}{{ page.metaTitle ?: page.title }} | {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: page.metaTitle ?: page.title,
        metaDescription: metaDescription,
        canonicalUrl: pageUrl,
        structuredData: {
            '@context': 'https://schema.org',
            '@type': 'WebPage',
            'name': page.metaTitle ?: page.title,
            'description': metaDescription,
            'url': pageUrl,
        },
    }) }}
{% endblock %}

{% block body %}
    {{ include('partials/_header.html.twig') }}

    <main id="contenu">
        {{ include('partials/_page_head.html.twig', {
            crumbs: [{ label: page.title }],
            title: page.title,
        }) }}

        <article class="bb-container bb-section--tight">
            <div class="bb-article-body bb-prose">
                {{ page.content|raw }}
            </div>
        </article>
    </main>

    {{ include('partials/_footer.html.twig') }}
{% endblock %}
