{# Carte article (charte 2026) : visuel arrondi avec la rubrique en
   pastille, titre, puis auteur · date · temps de lecture (sans chapô). Le compteur de vues n'est plus affiché tant qu'il n'est pas
   fiable (note du design V2). La carte entière est un lien ; les attributs
   data-impression-tracker-* alimentent les statistiques d'impressions.
   Attend : article (App\Entity\Article). Optionnels : rank (numéro de
   classement), headingLevel (2 ou 3, par défaut 3).
   Styles : .bb-card-a* dans assets/styles/content.css. #}
{% set author = article.author %}
{% set authorName = author ? (author.firstName ~ ' ' ~ author.lastName)|trim : site_settings().siteName %}
{% set tag = (headingLevel|default(3)) == 2 ? 'h2' : 'h3' %}
<a href="{{ path('app_article_show', { slug: article.slug }) }}" class="bb-card-a" data-impression-tracker-target="card" data-article-id="{{ article.id }}">
    <div class="bb-card-a-media bb-placeholder"{% if article.category %} style="--bb-cat:{{ article.category.color }}"{% endif %}>
        {% if article.coverImage %}
            <img src="{{ article.coverImage }}" alt="" loading="lazy" data-controller="cover-fit">
        {% endif %}
        {% if article.category %}
            <span class="bb-chip bb-chip--black bb-card-a-chip"><span class="bb-dot" aria-hidden="true"></span>{{ article.category.name }}</span>
        {% endif %}
        {% if rank is defined and rank %}
            <span class="bb-card-a-rank bb-display" aria-label="Classement {{ rank }}">{{ rank }}</span>
        {% endif %}
    </div>
    <div class="bb-card-a-body">
        <{{ tag }} class="bb-card-a-title">{{ article.title }}</{{ tag }}>
        <p class="bb-card-a-meta">
            <span>{{ authorName }}</span>
            {% if article.publishedAt %}<span aria-hidden="true">·</span><time datetime="{{ article.publishedAt|date('c') }}">{{ article.publishedAt|french_date_short }}</time>{% endif %}
            <span aria-hidden="true">·</span><span>{{ article.content|reading_time }} min</span>
        </p>
    </div>
</a>
