{# Card article, reproduction de celles de beninroots.bj : grande image
   zoomée au survol, rubrique en pastille teintée, titre, extrait, puis
   auteur · date · temps de lecture · vues sous un filet. Styles :
   .bb-article-card* dans assets/styles/app.css.
   Attend : article (App\Entity\Article). Optionnels : gradient (fond de
   secours sans image de couverture), rank (numéro affiché en haut à droite,
   pour les classements). #}
{% set author = article.author %}
{% set authorName = author ? (author.firstName ~ ' ' ~ author.lastName)|trim : site_settings().siteName %}
{% set initials = author ? author.firstName|first ~ author.lastName|first : authorName|slice(0, 2) %}
<a href="{{ path('app_article_show', { slug: article.slug }) }}" class="bb-article-card" data-impression-tracker-target="card" data-article-id="{{ article.id }}">
    <div class="bb-article-card-media" style="background:{{ gradient|default('linear-gradient(140deg,#2B6B43,#1C4A2E)') }}">
        {% if article.coverImage %}
            <img src="{{ article.coverImage }}" alt="{{ article.title }}" loading="lazy">
        {% endif %}
        {% if article.category %}
            <span class="bb-article-card-badge" style="--bb-cat:{{ article.category.color }}">{{ article.category.name }}</span>
        {% endif %}
        {% if rank is defined and rank %}
            <span class="bb-article-card-rank">#{{ rank }}</span>
        {% endif %}
    </div>
    <div class="bb-article-card-body">
        <h3 class="bb-article-card-title">{{ article.title }}</h3>
        {# Aperçu : le chapô, sinon la meta description, sinon le début du corps. #}
        {% set preview = (article.chapo|excerpt(220)) ?: (article.metaDescription|excerpt(220)) ?: (article.content|excerpt(220)) %}
        {% if preview %}
            <p class="bb-article-card-excerpt">{{ preview }}</p>
        {% endif %}
        <div class="bb-article-card-meta">
            <span class="bb-article-card-author">
                {% if author and author.avatar %}
                    <img src="{{ author.avatar }}" alt="{{ authorName }}" loading="lazy">
                {% else %}
                    <span class="bb-article-card-initials" aria-hidden="true">{{ initials|upper }}</span>
                {% endif %}
                <span>{{ authorName }}</span>
            </span>
            {% if article.publishedAt %}
                <span class="bb-article-card-info">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                    <time datetime="{{ article.publishedAt|date('c') }}">{{ article.publishedAt|french_date_short }}</time>
                </span>
            {% endif %}
            <span class="bb-article-card-info">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                <span>{{ article.content|reading_time }} min</span>
            </span>
            <span class="bb-article-card-info" title="Vues">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                <span>{{ article_views(article)|format_number }}<span class="bb-sr-only"> vues</span></span>
            </span>
        </div>
    </div>
</a>
