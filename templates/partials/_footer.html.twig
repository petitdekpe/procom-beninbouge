{# ===== PIED DE PAGE (charte 2026, V2) =====
   Liens et réseaux en texte, newsletter et coordonnées, puis l'outro de la
   charte « Le Bénin bouge. Et vous ? » avec le logo officiel (jamais
   redessiné) et la bande aux quatre couleurs de marque. Coordonnées et
   réseaux viennent des réglages du site ; la newsletter poste vers
   App\Controller\ContactController::subscribe.
   Styles : .bb-footer* dans assets/styles/layout.css. #}
{% set settings = site_settings() %}
{% set footerPages = static_pages() %}
{% set newsletterSuccess = app.flashes('newsletter_success')|first %}
{% set newsletterInfo = app.flashes('newsletter_info')|first %}
{% set newsletterError = app.flashes('newsletter_error')|first %}
{% set socials = [
    { url: settings.facebookUrl, label: 'Facebook' },
    { url: settings.instagramUrl, label: 'Instagram' },
    { url: settings.twitterUrl, label: 'X' },
    { url: settings.youtubeUrl, label: 'YouTube' },
    { url: settings.whatsappUrl, label: 'WhatsApp' },
]|filter(s => s.url) %}
<footer class="bb-footer">
    <div class="bb-container">
        <div class="bb-footer-top">
            <nav class="bb-footer-links" aria-label="Liens du site">
                <a href="{{ path('app_about') }}">À propos</a>
                <a href="{{ path('app_dossier_index') }}">Dossiers</a>
                <a href="{{ path('app_videos') }}">Vidéos</a>
                <a href="{{ path('app_announcement_index') }}">Annonces &amp; emploi</a>
                <a href="{{ path('app_announcement_submit') }}">Publier une annonce</a>
                <a href="{{ path('app_home') }}#contact">Nous joindre</a>
                {% for page in footerPages %}
                    <a href="{{ path('app_page_show', { slug: page.slug }) }}">{{ page.title }}</a>
                {% endfor %}
            </nav>
            {% if socials|length > 0 %}
                <nav class="bb-footer-links bb-footer-socials" aria-label="Réseaux sociaux">
                    {% for social in socials %}
                        <a href="{{ social.url }}" target="_blank" rel="noopener">{{ social.label }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
        </div>

        <div class="bb-footer-grid">
            <div id="newsletter" class="bb-footer-block">
                <h2 class="bb-footer-title">Newsletter</h2>
                <p class="bb-footer-text">L'essentiel du Bénin qui bouge, directement dans votre boîte mail.</p>
                <form method="post" action="{{ path('app_newsletter_subscribe') }}" class="bb-newsletter-form">
                    <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('newsletter') }}">
                    <div class="bb-hp" aria-hidden="true">
                        <label for="newsletter-website">Ne pas remplir</label>
                        <input type="text" id="newsletter-website" name="website" tabindex="-1" autocomplete="off">
                    </div>
                    <label for="newsletter-email" class="bb-sr-only">Votre adresse e-mail</label>
                    <input type="email" id="newsletter-email" name="email" class="bb-newsletter-input" placeholder="Votre adresse e-mail" required maxlength="180" autocomplete="email">
                    <button type="submit" class="bb-btn bb-btn--cta">S'inscrire</button>
                </form>
                {% if newsletterSuccess or newsletterInfo or newsletterError %}
                    <p class="bb-newsletter-feedback{{ newsletterError ? ' is-error' }}" role="status">{{ newsletterSuccess ?: newsletterInfo ?: newsletterError }}</p>
                {% endif %}
            </div>

            {% if settings.contactAddress or settings.contactPhone or settings.contactEmail %}
                <div class="bb-footer-block">
                    <h2 class="bb-footer-title">Contact</h2>
                    <ul class="bb-footer-contact">
                        {% if settings.contactAddress %}<li>{{ settings.contactAddress }}</li>{% endif %}
                        {% if settings.contactPhone %}<li><a href="tel:{{ settings.contactPhone|replace({' ': ''}) }}">{{ settings.contactPhone }}</a></li>{% endif %}
                        {% if settings.contactEmail %}<li><a href="mailto:{{ settings.contactEmail }}">{{ settings.contactEmail }}</a></li>{% endif %}
                    </ul>
                </div>
            {% endif %}

            <div class="bb-footer-block">
                <h2 class="bb-footer-title">{{ settings.siteName }}</h2>
                <p class="bb-footer-text">{{ settings.footerTagline ?: "Politique, économie, culture et initiatives locales : l'actualité béninoise vérifiée et racontée depuis le terrain." }}</p>
            </div>
        </div>

        <div class="bb-footer-outro">
            <p class="bb-display bb-footer-motto">Le Bénin bouge.<br><span class="bb-accent-forest">Et vous ?</span></p>
            <a href="{{ path('app_home') }}" class="bb-logo bb-footer-logo" aria-label="{{ settings.siteName }}, accueil">
                <img class="bb-logo-img bb-logo-img--light" src="{{ asset('images/logo-benin-bouge-noir.png') }}" alt="" width="800" height="302" loading="lazy">
                <img class="bb-logo-img bb-logo-img--dark" src="{{ asset('images/logo-benin-bouge-blanc.png') }}" alt="" width="800" height="302" loading="lazy">
            </a>
        </div>

        <p class="bb-footer-copy">© {{ "now"|date("Y") }} {{ settings.siteName }}. Tous droits réservés.</p>
    </div>
    <div class="bb-stripe" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
</footer>
