{# ===== FOOTER =====
   Calqué sur le footer de beninroots.bj : quatre colonnes (marque et
   réseaux sociaux, liens rapides, coordonnées, newsletter) puis une barre
   de copyright. Coordonnées et réseaux viennent des réglages du site ; la
   newsletter poste vers App\Controller\ContactController::subscribe.
   Styles : .bb-footer* dans assets/styles/app.css. #}
{% set settings = site_settings() %}
{% set footerPages = static_pages() %}
{% set newsletterSuccess = app.flashes('newsletter_success')|first %}
{% set newsletterInfo = app.flashes('newsletter_info')|first %}
{% set newsletterError = app.flashes('newsletter_error')|first %}
{% set socials = [
    { url: settings.facebookUrl, label: 'Facebook', icon: 'logo-facebook.svg' },
    { url: settings.twitterUrl, label: 'X / Twitter', icon: 'logo-twitter.svg' },
    { url: settings.instagramUrl, label: 'Instagram', icon: 'logo-instagram.svg' },
    { url: settings.youtubeUrl, label: 'YouTube', icon: 'logo-youtube.svg' },
    { url: settings.whatsappUrl, label: 'WhatsApp', icon: 'logo-whatsapp.svg' },
]|filter(s => s.url) %}
<footer class="bb-footer">
    <div class="bb-footer-inner">
        <div class="bb-footer-grid">
            <div>
                <a href="{{ path('app_home') }}" class="bb-footer-logo">
                    {% if settings.logoFooterUrl %}
                        <img src="{{ settings.logoFooterUrl }}" alt="{{ settings.siteName }}">
                    {% else %}
                        <span>{{ settings.siteName }}</span>
                    {% endif %}
                </a>
                <p class="bb-footer-text">{{ settings.footerTagline ?: "Politique, économie, culture et initiatives locales : l'actualité béninoise vérifiée et racontée depuis le terrain." }}</p>
                {% if socials|length > 0 %}
                    <div class="bb-footer-socials">
                        {% for social in socials %}
                            <a href="{{ social.url }}" target="_blank" rel="noopener" class="bb-footer-social" aria-label="{{ social.label }}">
                                <img src="{{ asset('assets/icons/' ~ social.icon) }}" alt="" class="bb-social-icon" width="18" height="18">
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div>
                <h3 class="bb-footer-title">Liens rapides</h3>
                <ul class="bb-footer-links">
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_home') }}#actu">Actualité</a></li>
                    <li><a href="{{ path('app_dossier_index') }}">Dossiers</a></li>
                    <li><a href="{{ path('app_videos') }}">Vidéos</a></li>
                    <li><a href="{{ path('app_announcement_index') }}">Annonces & Opportunités</a></li>
                    <li><a href="{{ path('app_about') }}">À propos</a></li>
                    <li><a href="{{ path('app_home') }}#contact">Nous joindre</a></li>
                </ul>
            </div>

            <div>
                <h3 class="bb-footer-title">Contact</h3>
                <ul class="bb-footer-links bb-footer-contact">
                    {% if settings.contactAddress %}
                        <li>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                            <span>{{ settings.contactAddress }}</span>
                        </li>
                    {% endif %}
                    {% if settings.contactPhone %}
                        <li>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
                            <a href="tel:{{ settings.contactPhone|replace({' ': ''}) }}">{{ settings.contactPhone }}</a>
                        </li>
                    {% endif %}
                    {% if settings.contactEmail %}
                        <li>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
                            <a href="mailto:{{ settings.contactEmail }}">{{ settings.contactEmail }}</a>
                        </li>
                    {% endif %}
                    <li>
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                        <a href="{{ path('app_home') }}#contact">Écrivez-nous</a>
                    </li>
                </ul>
            </div>

            <div id="newsletter">
                <h3 class="bb-footer-title">Newsletter</h3>
                <p class="bb-footer-text">Abonnez-vous pour recevoir les dernières actualités du Bénin qui bouge.</p>
                <form method="post" action="{{ path('app_newsletter_subscribe') }}" class="bb-newsletter-form">
                    <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('newsletter') }}">
                    <div class="bb-hp" aria-hidden="true">
                        <label for="newsletter-website">Ne pas remplir</label>
                        <input type="text" id="newsletter-website" name="website" tabindex="-1" autocomplete="off">
                    </div>
                    <label for="newsletter-email" class="bb-sr-only">Votre email</label>
                    <input type="email" id="newsletter-email" name="email" class="bb-newsletter-input" placeholder="Votre email" required maxlength="180" autocomplete="email">
                    <button type="submit" class="bb-newsletter-button" aria-label="S'inscrire à la newsletter">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.714 3.048a.498.498 0 0 0-.683.627l2.843 7.627a2 2 0 0 1 0 1.396l-2.842 7.627a.498.498 0 0 0 .682.627l18-8.5a.5.5 0 0 0 0-.904z"/><path d="M6 12h16"/></svg>
                    </button>
                </form>
                {% if newsletterSuccess or newsletterInfo or newsletterError %}
                    <p class="bb-newsletter-feedback{{ newsletterError ? ' is-error' }}" role="status">{{ newsletterSuccess ?: newsletterInfo ?: newsletterError }}</p>
                {% endif %}
            </div>
        </div>

        <div class="bb-footer-bottom">
            <p>© {{ "now"|date("Y") }} {{ settings.siteName }}. Tous droits réservés.</p>
            {% if footerPages|length > 0 %}
                <nav class="bb-footer-pages" aria-label="Pages du site">
                    {% for page in footerPages %}
                        <a href="{{ path('app_page_show', { slug: page.slug }) }}">{{ page.title }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
        </div>
    </div>
</footer>
