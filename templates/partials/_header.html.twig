{% set settings = site_settings() %}
{# ===== MAIN HEADER =====
   Calqué sur le header de beninroots.bj : barre blanche collante, logo à
   gauche, liens à droite, tiroir latéral sous 768px — voir
   assets/controllers/nav_toggle_controller.js et .bb-header* dans
   assets/styles/app.css. #}
{% set currentRoute = app.request.attributes.get('_route') ?? '' %}
{% set navItems = [
    { label: 'Accueil', href: path('app_home'), active: currentRoute == 'app_home' },
    { label: 'Actualité', href: path('app_home') ~ '#actu', active: currentRoute in ['app_article_show', 'app_category_show', 'app_tag_show'] },
    { label: 'Dossiers', href: path('app_dossier_index'), active: currentRoute starts with 'app_dossier' },
    { label: 'Vidéos', href: path('app_videos'), active: currentRoute == 'app_videos' },
    { label: 'Annonces', href: path('app_announcement_index'), active: currentRoute starts with 'app_announcement' },
    { label: 'À propos', href: path('app_about'), active: currentRoute == 'app_about' },
    { label: 'Nous joindre', href: path('app_home') ~ '#contact', active: false },
] %}
<header class="bb-header" data-controller="nav-toggle" data-action="keydown.esc@window->nav-toggle#close">
    <div class="bb-header-inner">
        <a href="{{ path('app_home') }}" class="bb-header-logo">
            {% if settings.logoUrl %}
                <img src="{{ settings.logoUrl }}" alt="{{ settings.siteName }}">
            {% else %}
                <span>{{ settings.siteName }}</span>
            {% endif %}
        </a>

        <nav class="bb-header-nav" aria-label="Navigation principale">
            {% for item in navItems %}
                <a href="{{ item.href }}" class="bb-header-link{{ item.active ? ' is-active' }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
        </nav>

        <button type="button" class="bb-menu-toggle" data-action="nav-toggle#open" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="bb-drawer" data-nav-toggle-target="button">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
        </button>
    </div>

    <div class="bb-drawer-overlay" data-nav-toggle-target="overlay" data-action="click->nav-toggle#close" hidden></div>
    <div class="bb-drawer" id="bb-drawer" role="dialog" aria-modal="true" aria-label="Menu" data-nav-toggle-target="drawer" hidden>
        <button type="button" class="bb-drawer-close" data-action="nav-toggle#close" aria-label="Fermer le menu">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
        <nav class="bb-drawer-nav" aria-label="Navigation mobile">
            {% for item in navItems %}
                <a href="{{ item.href }}" class="bb-drawer-link{{ item.active ? ' is-active' }}" data-action="nav-toggle#close">{{ item.label }}</a>
            {% endfor %}
        </nav>
        {% if settings.whatsappUrl %}
            <div class="bb-drawer-footer">
                <a href="{{ settings.whatsappUrl }}" target="_blank" rel="noopener" class="bb-drawer-whatsapp">
                    <img src="{{ asset('assets/icons/logo-whatsapp.svg') }}" alt="" width="16" height="16"> Canal WhatsApp
                </a>
            </div>
        {% endif %}
    </div>
</header>
