{% set settings = site_settings() %}
{# ===== UTILITY STRIP ===== #}
<div style="background:#2B6B43;color:#EAF3EC">
    <div style="max-width:1240px;margin:0 auto;padding:8px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:12.5px">
        <div style="display:flex;align-items:center;gap:10px;font-weight:600;letter-spacing:.2px">
            <span style="color:#F7CA46;font-weight:800">☀</span>
            <span>{{ date()|french_date }}</span>
            {% if settings.contactAddress %}
                <span style="opacity:.5">·</span>
                <span style="opacity:.85">{{ settings.contactAddress }}</span>
            {% endif %}
        </div>
        <div class="bb-utility-social" style="display:flex;align-items:center;gap:16px">
            {% if settings.facebookUrl or settings.twitterUrl or settings.instagramUrl or settings.youtubeUrl %}
                <div style="display:flex;align-items:center;gap:8px">
                    {% if settings.facebookUrl %}<a href="{{ settings.facebookUrl }}" target="_blank" rel="noopener" style="width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.12);display:grid;place-items:center;text-decoration:none"><img src="{{ asset('assets/icons/logo-facebook.svg') }}" alt="Facebook" class="bb-social-icon" style="width:13px;height:13px"></a>{% endif %}
                    {% if settings.twitterUrl %}<a href="{{ settings.twitterUrl }}" target="_blank" rel="noopener" style="width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.12);display:grid;place-items:center;text-decoration:none"><img src="{{ asset('assets/icons/logo-twitter.svg') }}" alt="X / Twitter" class="bb-social-icon" style="width:12px;height:12px"></a>{% endif %}
                    {% if settings.instagramUrl %}<a href="{{ settings.instagramUrl }}" target="_blank" rel="noopener" style="width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.12);display:grid;place-items:center;text-decoration:none"><img src="{{ asset('assets/icons/logo-instagram.svg') }}" alt="Instagram" class="bb-social-icon" style="width:12px;height:12px"></a>{% endif %}
                    {% if settings.youtubeUrl %}<a href="{{ settings.youtubeUrl }}" target="_blank" rel="noopener" style="width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.12);display:grid;place-items:center;text-decoration:none"><img src="{{ asset('assets/icons/logo-youtube.svg') }}" alt="YouTube" class="bb-social-icon" style="width:13px;height:13px"></a>{% endif %}
                </div>
            {% endif %}
            {% if settings.whatsappUrl %}
                <a href="{{ settings.whatsappUrl }}" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:7px;background:#F7CA46;color:#14160F;padding:5px 13px;border-radius:999px;font-weight:800;font-size:12px;text-decoration:none">
                    <img src="{{ asset('assets/icons/logo-whatsapp.svg') }}" alt="" style="width:14px;height:14px;display:block"> Canal WhatsApp
                </a>
            {% endif %}
        </div>
    </div>
</div>

{# ===== MAIN HEADER ===== #}
<header style="position:sticky;top:0;z-index:50;background:rgba(255,255,255,.97);backdrop-filter:blur(10px);border-bottom:1px solid #e6e3d7">
    <div style="position:relative;max-width:1240px;margin:0 auto;padding:16px 24px;display:flex;align-items:center;gap:28px" data-controller="nav-toggle">
        <a href="{{ path('app_home') }}" style="flex:none;display:flex;align-items:center;text-decoration:none">
            {% if settings.logoUrl %}
                <img src="{{ settings.logoUrl }}" alt="{{ settings.siteName }}" style="height:34px;width:auto;display:block">
            {% else %}
                <span style="font-family:'Archivo';font-weight:900;font-size:20px;color:#14160F">{{ settings.siteName }}</span>
            {% endif %}
        </a>
        <nav class="bb-header-nav" data-nav-toggle-target="nav" style="flex:1;display:flex;align-items:center;gap:28px;margin-left:8px">
            <a href="{{ path('app_home') }}" style="text-decoration:none;color:#2B6B43;font-weight:800;font-size:14px;letter-spacing:.2px">Accueil</a>
            <a href="{{ path('app_home') }}#actu" class="bb-h" style="text-decoration:none;color:#3a3f33;font-weight:700;font-size:14px;letter-spacing:.2px">Actualité</a>
            <a href="{{ path('app_dossier_index') }}" class="bb-h" style="text-decoration:none;color:#3a3f33;font-weight:700;font-size:14px;letter-spacing:.2px">Dossiers</a>
            <a href="{{ path('app_videos') }}" class="bb-h" style="text-decoration:none;color:#3a3f33;font-weight:700;font-size:14px;letter-spacing:.2px">Vidéos</a>
        </nav>
        <button type="button" class="bb-menu-toggle" data-action="click->nav-toggle#toggle" aria-label="Ouvrir le menu">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#14160F" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
    </div>
</header>
