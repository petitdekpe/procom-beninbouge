{# Carte vidéo (page /videos) : vignette 16:9 arrondie avec bouton lecture
   jaune, titre, description, rubrique et date. S'ouvre dans le lecteur en
   surimpression (contrôleur video-modal posé sur la page).
   Attend : media (App\Entity\Media). Styles : .bb-vcard* dans assets/styles/content.css. #}
{% set title = media.title ?: (media.article ? media.article.title : 'Vidéo Bénin Bouge') %}
<a href="{{ media.youtubeEmbedSrc ?: '#' }}"
   class="bb-vcard"
   data-action="video-modal#open"
   data-video-modal-url-param="{{ media.youtubeEmbedSrc }}">
    <span class="bb-vcard-media bb-placeholder" style="--bb-cat:#0E3F51">
        {% if media.effectiveThumbnail %}<img src="{{ media.effectiveThumbnail }}" alt="" loading="lazy">{% endif %}
        <span class="bb-vrail-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11.04-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14Z"/></svg>
        </span>
    </span>
    <span class="bb-vcard-title">{{ title }}</span>
    {% if media.description %}<span class="bb-vcard-desc">{{ media.description|excerpt(220) }}</span>{% endif %}
    <span class="bb-vcard-meta">{% if media.article and media.article.category %}{{ media.article.category.name }} · {% endif %}{{ media.createdAt|time_ago }}</span>
</a>
