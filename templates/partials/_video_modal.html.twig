{# Lecteur vidéo en surimpression : doit être inclus à l'intérieur d'un
   élément portant data-controller="video-modal"
   (voir assets/controllers/video_modal_controller.js).
   Styles : .bb-vmodal* dans assets/styles/content.css. #}
<div class="bb-vmodal"
     data-video-modal-target="overlay"
     data-action="click->video-modal#closeOnBackdrop keydown.esc@window->video-modal#closeOnEscape"
     style="display:none">
    <div class="bb-vmodal-inner">
        <button type="button" class="bb-icon-btn bb-vmodal-close" data-action="video-modal#close" aria-label="Fermer la vidéo">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
        <div class="bb-vmodal-frame">
            <iframe data-video-modal-target="iframe" src="" title="Lecteur vidéo"
                    allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>
</div>
