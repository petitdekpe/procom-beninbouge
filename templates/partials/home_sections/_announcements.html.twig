{# « Ça recrute au Bénin. » (section « Annonces & Opportunités ») : grand
   aplat jaune de la charte, appel à publier, et les annonces en ligne ayant
   acheté l'option « carte sur l'accueil » (3 au plus) en cartes noires.
   Toujours affichée : c'est l'appel à publier qui compte, même sans carte.
   Attend : announcements (list<Announcement>), jobsCount (int).
   Styles : .bb-jobs*, .bb-job-card* dans assets/styles/home.css. #}
{% set chipByCategory = {
    'emploi': 'bb-chip--light',
    'appel-offres': 'bb-chip--white',
    'bourse-formation': 'bb-chip--tomato',
    'evenement': 'bb-chip--gold',
    'annonce': 'bb-chip--white',
} %}
<section id="annonces" class="bb-jobs" aria-labelledby="jobs-title">
    <div class="bb-container">
        <div class="bb-jobs-head">
            <h2 id="jobs-title" class="bb-display bb-mega">Ça recrute<br>au Bénin.</h2>
            <div class="bb-jobs-intro">
                <p>Emplois, appels d'offres, bourses, formations, événements : publiez votre annonce sur {{ site_settings().siteName }}, validée par la rédaction sous 48 h.</p>
                <div class="bb-jobs-actions">
                    <a href="{{ path('app_announcement_submit') }}" class="bb-btn bb-btn--black-gold">Publier une annonce <span aria-hidden="true">→</span></a>
                    {% if jobsCount > 0 %}
                        <a href="{{ path('app_announcement_index') }}" class="bb-jobs-all">Voir les {{ jobsCount }} annonce{{ jobsCount > 1 ? 's' }} en ligne <span aria-hidden="true">→</span></a>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if announcements|length > 0 %}
            <ul class="bb-jobs-grid">
                {% for announcement in announcements %}
                    <li>
                        <a href="{{ path('app_announcement_show', { reference: announcement.reference }) }}" class="bb-job-card">
                            <span class="bb-chip {{ chipByCategory[announcement.category.value] ?? 'bb-chip--white' }}">{{ announcement.category.label }}</span>
                            <strong class="bb-job-card-title">{{ announcement.title }}</strong>
                            <span class="bb-job-card-org">{{ announcement.organization }}{% if announcement.location %} · {{ announcement.location }}{% endif %}</span>
                            {% if announcement.deadline %}
                                <span class="bb-job-card-deadline">Jusqu'au {{ announcement.deadline|french_date_short }}</span>
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>
