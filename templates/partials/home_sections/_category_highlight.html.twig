{# Attend : category (App\Entity\Category), articles (list<Article>), gradientPalette (list<string>). #}
<section id="rubrique-{{ category.slug }}" style="max-width:var(--bb-container);margin:64px auto 0;padding:0 24px">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:30px">
        <div>
            <span style="display:inline-block;background:{{ category.color }};color:#fff;font-weight:800;font-size:11.5px;letter-spacing:.5px;padding:7px 16px;border-radius:999px;text-transform:uppercase">{{ category.name }}</span>
            <h2 style="font-family:'Archivo';font-weight:900;font-size:32px;color:#14160F;margin-top:16px;letter-spacing:-.4px">À la une : <em style="font-style:italic;color:#2B6B43">{{ category.name }}</em></h2>
        </div>
        <a href="{{ path('app_category_show', { slug: category.slug }) }}" style="text-decoration:none;color:#2B6B43;font-weight:800;font-size:13px;white-space:nowrap">Toute la rubrique →</a>
    </div>

    {% if articles|length > 0 %}
    <div class="bb-grid-3" style="gap:32px" data-controller="impression-tracker" data-impression-tracker-context-value="home_category_highlight">
        {% for article in articles %}
            {% set gradient = gradientPalette[loop.index0 % 4] %}
            {{ include('partials/_article_card.html.twig', { article: article, gradient: gradient }) }}
        {% endfor %}
    </div>
    {% else %}
        <p class="bb-empty">Aucun article publié dans cette rubrique pour le moment.</p>
    {% endif %}
</section>
