{# Rubrique mise en avant : nom de la rubrique en grand avec une flèche dans
   sa couleur, puis ses 3 derniers articles en cartes.
   Attend : category (App\Entity\Category), articles (list<Article>).
   Rien n'est affiché sans article. #}
{% if articles|length > 0 %}
    <section id="rubrique-{{ category.slug }}" class="bb-container bb-section bb-rubrique" style="--bb-cat:{{ category.color }}" aria-labelledby="rubrique-{{ category.slug }}-title">
        <div class="bb-sec-head">
            <div>
                <span class="bb-kicker">La rubrique</span>
                <h2 id="rubrique-{{ category.slug }}-title" class="bb-display bb-h2">{{ category.name }} <span class="bb-rubrique-arrow" aria-hidden="true">→</span></h2>
            </div>
            <a href="{{ path('app_category_show', { slug: category.slug }) }}" class="bb-more">Toute la rubrique <span aria-hidden="true">→</span></a>
        </div>
        <div class="bb-grid-3" data-controller="impression-tracker" data-impression-tracker-context-value="home_category_highlight">
            {% for article in articles %}
                {{ include('partials/_article_card.html.twig', { article: article }) }}
            {% endfor %}
        </div>
    </section>
{% endif %}
