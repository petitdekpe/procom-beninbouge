{# Section « Nous joindre » de l'accueil : un simple appel qui renvoie vers la
   page Contact (App\Controller\ContactController::index), où se trouve le
   formulaire. Styles : .bb-contact* dans assets/styles/pages.css. #}
<section id="contact" class="bb-contact bb-contact--cta" aria-labelledby="contact-title">
    <div class="bb-container bb-contact-cta">
        <div class="bb-contact-head">
            <span class="bb-kicker">Nous joindre</span>
            <h2 id="contact-title" class="bb-display bb-h2">Écrivez à la rédaction.</h2>
            <p class="bb-lead">Une information, une suggestion, un partenariat : écrivez-nous.</p>
        </div>
        <a href="{{ path('app_contact') }}" class="bb-btn bb-btn--cta bb-contact-cta-btn">Nous joindre <span aria-hidden="true">→</span></a>
    </div>
</section>
