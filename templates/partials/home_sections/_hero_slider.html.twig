{# Attend : slides (list<Article>, peut être vide).
   Calqué sur la section « accueil » de beninroots.bj : plein écran, fondu
   enchaîné entre les diapositives, voile dégradé de gauche à droite, texte
   centré verticalement, puces en bas (la puce active s'allonge). Rotation
   toutes les 10 s, stoppée dès que le lecteur choisit une diapositive ;
   balayage tactile sur mobile. Voir
   assets/controllers/hero_slider_controller.js et .bb-hero* dans
   assets/styles/app.css. #}
<section id="accueil" class="bb-hero" {% if slides|length > 1 %}data-controller="hero-slider" data-action="touchstart->hero-slider#touchStart:passive touchmove->hero-slider#touchMove:passive touchend->hero-slider#touchEnd"{% endif %}>
    {% if slides|length > 0 %}
        {% for featured in slides %}
            <div class="bb-hero-slide{{ loop.first ? ' is-active' }}" {% if slides|length > 1 %}data-hero-slider-target="slide"{% endif %} {% if not loop.first %}aria-hidden="true" inert{% endif %}>
                <div class="bb-hero-bg" {% if featured.coverImage %}style="background-image:url('{{ featured.coverImage }}')"{% endif %}></div>
                <div class="bb-hero-inner">
                    <div class="bb-hero-content">
                        {% if featured.category %}
                            <a href="{{ path('app_category_show', { slug: featured.category.slug }) }}" class="bb-hero-badge">{{ featured.category.name }}</a>
                        {% endif %}
                        {% if loop.first %}
                            <h1 class="bb-hero-title">{{ featured.title }}</h1>
                        {% else %}
                            <h2 class="bb-hero-title">{{ featured.title }}</h2>
                        {% endif %}
                        {% if featured.chapo %}
                            <p class="bb-hero-text">{{ featured.chapo|striptags }}</p>
                        {% endif %}
                        <div class="bb-hero-actions">
                            <a href="{{ path('app_article_show', { slug: featured.slug }) }}" class="bb-hero-button">Lire l'article</a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% if slides|length > 1 %}
            <div class="bb-hero-dots">
                {% for s in slides %}
                    <button type="button" class="bb-hero-dot{{ loop.first ? ' is-active' }}" data-hero-slider-target="dot" data-action="hero-slider#goTo" data-hero-slider-index-param="{{ loop.index0 }}" aria-label="Aller à la diapositive {{ loop.index }}"{% if loop.first %} aria-current="true"{% endif %}></button>
                {% endfor %}
            </div>
        {% endif %}
    {% else %}
        <div class="bb-hero-slide is-active">
            <div class="bb-hero-bg"></div>
            <div class="bb-hero-inner">
                <div class="bb-hero-content">
                    <h1 class="bb-hero-title">Le Bénin qui bouge, raconté au quotidien</h1>
                    <p class="bb-hero-text">Politique, économie, culture et initiatives locales : l'actualité béninoise vérifiée et racontée depuis le terrain.</p>
                    <div class="bb-hero-actions">
                        <a href="{{ path('app_home') }}#actu" class="bb-hero-button">Lire les dernières actus</a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</section>
