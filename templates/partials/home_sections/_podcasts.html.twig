{# Attend : podcasts (list<Media>). #}
<section id="podcasts" style="max-width:1240px;margin:64px auto 0;padding:0 24px">
    <div style="margin-bottom:30px">
        <span style="display:inline-block;background:#0E3F51;color:#fff;font-weight:800;font-size:11.5px;letter-spacing:.5px;padding:7px 16px;border-radius:999px;text-transform:uppercase">Podcasts</span>
        <h2 style="font-family:'Archivo';font-weight:900;font-size:32px;color:#14160F;margin-top:16px;letter-spacing:-.4px">À <em style="font-style:italic;color:#2B6B43">écouter</em></h2>
    </div>

    {% if podcasts|length > 0 %}
    <div style="display:flex;flex-direction:column;gap:16px">
        {% for media in podcasts %}
            <div class="bb-card" style="background:#fff;border-radius:14px;padding:18px 20px;display:flex;align-items:center;gap:18px;flex-wrap:wrap">
                <div style="flex:1;min-width:220px">
                    <h3 style="font-family:'Archivo';font-weight:800;font-size:16px;color:#14160F">{{ media.title ?: 'Podcast Bénin Bouge' }}</h3>
                    <div style="color:#8a8a7c;font-size:12px;font-weight:600;margin-top:6px">{% if media.author %}{{ media.author.firstName }} {{ media.author.lastName }} · {% endif %}{{ media.createdAt|time_ago }}</div>
                </div>
                {% if media.audioUrl %}
                    <audio controls preload="none" style="max-width:100%;flex:0 0 320px">
                        <source src="{{ media.audioUrl }}">
                    </audio>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    {% else %}
        <p class="bb-empty">Aucun podcast publié pour le moment.</p>
    {% endif %}
</section>
