{# Podcast + WhatsApp (section « Podcasts ») : le dernier épisode sur aplat
   rouge tomate, avec son lecteur, et la carte « L'actu dans ton WhatsApp »
   en vert clair quand la chaîne WhatsApp est renseignée dans les réglages.
   Attend : podcasts (list<Media>, le premier mis en avant). Rien n'est
   affiché sans épisode ni chaîne WhatsApp.
   Styles : .bb-listen*, .bb-podcast*, .bb-whatsapp* dans assets/styles/home.css. #}
{% set whatsappUrl = site_settings().whatsappUrl %}
{% set episode = podcasts|first %}
{% if episode or whatsappUrl %}
    <section id="podcasts" class="bb-container bb-section bb-listen{{ episode and whatsappUrl ? ' has-both' }}" aria-label="À écouter et à suivre">
        {% if episode %}
            <article class="bb-podcast">
                <span class="bb-kicker bb-podcast-kicker">Podcast · À écouter</span>
                <h2 class="bb-display bb-podcast-title">{{ episode.title ?: 'Le podcast Bénin Bouge' }}</h2>
                {% if episode.audioUrl %}
                    <div class="bb-wave" aria-hidden="true">
                        {% for h in [20, 44, 30, 56, 24, 40, 16, 48, 28, 36, 20, 12, 26, 18, 34, 22, 46, 14] %}<span style="height:{{ h }}px"></span>{% endfor %}
                    </div>
                    <audio class="bb-podcast-audio" controls preload="none">
                        <source src="{{ episode.audioUrl }}">
                    </audio>
                {% endif %}
                {% if podcasts|length > 1 %}
                    <ul class="bb-podcast-more">
                        {% for media in podcasts|slice(1) %}
                            <li>
                                <span>{{ media.title ?: 'Épisode' }}</span>
                                {% if media.audioUrl %}<a href="{{ media.audioUrl }}" target="_blank" rel="noopener">Écouter <span aria-hidden="true">→</span></a>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </article>
        {% endif %}

        {% if whatsappUrl %}
            <div class="bb-whatsapp">
                <h2 class="bb-display bb-whatsapp-title">L'actu dans ton WhatsApp.</h2>
                <p>L'essentiel du Bénin, chaque matin, sans chercher.</p>
                <a href="{{ whatsappUrl }}" target="_blank" rel="noopener" class="bb-btn bb-btn--black">Suivez le Bénin qui bouge <span aria-hidden="true">→</span></a>
            </div>
        {% endif %}
    </section>
{% endif %}
