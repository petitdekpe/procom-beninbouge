{# Section « Articles populaires » quand « La une » est désactivée (sinon les
   plus lus sont déjà dans sa grille). Attend : popular (list<Article>).
   Rien n'est affiché sans article. #}
{% if popular|length > 0 %}
    <div id="populaires" class="bb-container bb-section--tight" data-controller="impression-tracker" data-impression-tracker-context-value="home_popular_articles">
        {{ include('partials/home_sections/_most_read.html.twig', { items: popular, extraClass: 'bb-mostread--wide' }) }}
    </div>
{% endif %}
