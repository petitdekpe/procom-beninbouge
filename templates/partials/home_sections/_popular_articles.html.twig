{# Attend : popular (list<Article>), gradientPalette (list<string>). #}
<section id="populaires" style="max-width:1240px;margin:64px auto 0;padding:0 24px">
    <div style="margin-bottom:30px">
        <span style="display:inline-block;background:#F7CA46;color:#14160F;font-weight:800;font-size:11.5px;letter-spacing:.5px;padding:7px 16px;border-radius:999px;text-transform:uppercase">Populaires</span>
        <h2 style="font-family:'Archivo';font-weight:900;font-size:32px;color:#14160F;margin-top:16px;letter-spacing:-.4px">Les plus <em style="font-style:italic;color:#2B6B43">lus</em></h2>
    </div>

    {% if popular|length > 0 %}
    <div class="bb-grid-4" style="gap:20px" data-controller="impression-tracker" data-impression-tracker-context-value="home_popular_articles">
        {% for article in popular %}
            {% set gradient = gradientPalette[loop.index0 % 4] %}
            <a href="{{ path('app_article_show', { slug: article.slug }) }}" class="bb-card" data-impression-tracker-target="card" data-article-id="{{ article.id }}" style="text-decoration:none;background:#fff;border-radius:13px;overflow:hidden;box-shadow:0 10px 26px -22px rgba(20,22,15,.55)">
                <div style="position:relative;aspect-ratio:5/3;overflow:hidden">
                    <div class="bb-zoom" style="position:absolute;inset:0;{% if article.coverImage %}background:url('{{ article.coverImage }}') center/cover{% else %}background:{{ gradient }}{% endif %}"></div>
                    <span style="position:absolute;top:10px;left:10px;background:#14160F;color:#F7CA46;font-size:10px;font-weight:800;letter-spacing:.4px;padding:4px 8px;border-radius:5px;text-transform:uppercase">#{{ loop.index }}</span>
                </div>
                <div style="padding:14px 14px 17px">
                    <h3 class="bb-h" style="font-family:'Archivo';font-weight:800;font-size:15.5px;line-height:1.22;color:#14160F">{{ article.title }}</h3>
                    <div style="color:#8a8a7c;font-size:11.5px;font-weight:600;margin-top:9px">{{ article.publishedAt|time_ago }}</div>
                </div>
            </a>
        {% endfor %}
    </div>
    {% else %}
        <p class="bb-empty">Pas encore assez de lectures pour établir un classement.</p>
    {% endif %}
</section>
