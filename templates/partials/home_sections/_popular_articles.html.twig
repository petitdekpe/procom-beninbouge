{# Attend : popular (list<Article>), gradientPalette (list<string>). #}
<section id="populaires" style="max-width:var(--bb-container);margin:64px auto 0;padding:0 24px">
    <div style="margin-bottom:30px">
        <span style="display:inline-block;background:#F7CA46;color:#14160F;font-weight:800;font-size:11.5px;letter-spacing:.5px;padding:7px 16px;border-radius:999px;text-transform:uppercase">Populaires</span>
        <h2 style="font-family:'Archivo';font-weight:900;font-size:32px;color:#14160F;margin-top:16px;letter-spacing:-.4px">Les plus <em style="font-style:italic;color:#2B6B43">lus</em></h2>
    </div>

    {% if popular|length > 0 %}
    <div class="bb-grid-3" style="gap:32px" data-controller="impression-tracker" data-impression-tracker-context-value="home_popular_articles">
        {% for article in popular %}
            {% set gradient = gradientPalette[loop.index0 % 4] %}
            {{ include('partials/_article_card.html.twig', { article: article, gradient: gradient, rank: loop.index }) }}
        {% endfor %}
    </div>
    {% else %}
        <p class="bb-empty">Pas encore assez de lectures pour établir un classement.</p>
    {% endif %}
</section>
