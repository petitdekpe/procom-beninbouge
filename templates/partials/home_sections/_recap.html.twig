{# Section « Récap » de l'accueil : vidéos au format mobile, en cartes
   verticales 9:16. Chaque carte mène à la page du récap, où la vidéo
   s'affiche à gauche et le texte à droite. Défilement horizontal sur mobile.
   Attend : recaps (list<App\Entity\Recap>, déjà publiés).
   Rien n'est affiché sans récap. Styles : .bb-recap-rail* dans assets/styles/home.css. #}
{% if recaps|length > 0 %}
    {% set newSince = date('-3 days') %}
    <section id="recap" class="bb-container bb-section bb-recap-rail" aria-labelledby="recap-title">
        <div class="bb-sec-head">
            <div>
                <span class="bb-kicker">L'essentiel en vidéo</span>
                <h2 id="recap-title" class="bb-display bb-h2">Récap</h2>
            </div>
        </div>

        <ul class="bb-recap-rail-list">
            {% for recap in recaps %}
                <li>{{ include('partials/_recap_card.html.twig', { recap: recap, isNew: recap.publishedAt and recap.publishedAt > newSince }) }}</li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
