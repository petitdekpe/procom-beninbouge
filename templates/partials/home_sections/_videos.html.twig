{# Attend : videos (list<Media>).
   Vidéothèque calquée sur celle de beninroots.bj : fond sombre, grand
   lecteur YouTube intégré à gauche, playlist défilante à droite ; cliquer
   une vidéo de la playlist la charge dans le lecteur. Les vidéos viennent
   de la chaîne YouTube (commande app:sync-youtube-videos) et des médias
   saisis dans l'admin. Voir assets/controllers/video_library_controller.js
   et .bb-vtheque* dans assets/styles/app.css. #}
{% set channelUrl = site_settings().youtubeUrl ?: 'https://www.youtube.com/@BeninBouge' %}
{% set playable = videos|filter(v => v.youtubeEmbedSrc) %}
<section id="videos" class="bb-vtheque">
    <div class="bb-vtheque-inner">
        <div class="bb-vtheque-head">
            <span class="bb-vtheque-badge">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
                Vidéothèque
            </span>
            <h2 class="bb-vtheque-title">Vidéos incontournables</h2>
            <p class="bb-vtheque-lead">Reportages, interviews et formats courts filmés sur le terrain, pour voir le Bénin qui bouge autrement.</p>
        </div>

        {% if playable|length > 0 %}
            {% set current = playable|first %}
            <div class="bb-vtheque-grid" data-controller="video-library">
                <div class="bb-vtheque-player">
                    <div class="bb-vtheque-frame">
                        <iframe data-video-library-target="frame"
                                src="{{ current.youtubeEmbedSrc }}?autoplay=0&amp;rel=0&amp;modestbranding=1"
                                title="{{ current.title ?: 'Vidéo Bénin Bouge' }}"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen loading="lazy"></iframe>
                    </div>
                    <div class="bb-vtheque-info">
                        <h3 class="bb-vtheque-info-title" data-video-library-target="title">{{ current.title ?: 'Vidéo Bénin Bouge' }}</h3>
                        <p class="bb-vtheque-info-text" data-video-library-target="description">{{ current.description|excerpt(400) }}</p>
                    </div>
                </div>

                <div class="bb-vtheque-playlist">
                    <h3 class="bb-vtheque-playlist-title">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
                        Playlist ({{ playable|length }})
                    </h3>
                    <div class="bb-vtheque-list">
                        {% for media in playable %}
                            {% set title = media.title ?: (media.article ? media.article.title : 'Vidéo Bénin Bouge') %}
                            <button type="button"
                                    class="bb-vtheque-item{{ loop.first ? ' is-active' }}"
                                    data-video-library-target="item"
                                    data-action="video-library#select"
                                    data-video-library-url-param="{{ media.youtubeEmbedSrc }}"
                                    data-video-library-title-param="{{ title }}"
                                    data-video-library-description-param="{{ media.description|excerpt(400) }}"
                                    {% if loop.first %}aria-current="true"{% endif %}>
                                <span class="bb-vtheque-thumb">
                                    {% if media.effectiveThumbnail %}
                                        <img src="{{ media.effectiveThumbnail }}" alt="" loading="lazy">
                                    {% endif %}
                                    <span class="bb-vtheque-thumb-play" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
                                    </span>
                                </span>
                                <span class="bb-vtheque-item-text">
                                    <span class="bb-vtheque-item-title">{{ title }}</span>
                                    {% if media.description %}
                                        <span class="bb-vtheque-item-desc">{{ media.description|excerpt(120) }}</span>
                                    {% endif %}
                                </span>
                            </button>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% else %}
            <p class="bb-empty">Aucune vidéo publiée pour le moment.</p>
        {% endif %}

        <div class="bb-vtheque-actions">
            <a href="{{ channelUrl }}" target="_blank" rel="noopener" class="bb-vtheque-channel">
                <img src="{{ asset('assets/icons/logo-youtube.svg') }}" alt="" class="bb-social-icon" width="18" height="18">
                Voir la chaîne YouTube
            </a>
            <a href="{{ path('app_videos') }}" class="bb-vtheque-all">Toutes les vidéos →</a>
        </div>
    </div>
</section>
