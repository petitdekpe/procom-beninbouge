{# Section vidéo de l'accueil (charte 2026) : bloc bleu pétrole, cartes
   verticales qui s'ouvrent dans le lecteur en surimpression
   (assets/controllers/video_modal_controller.js, contrôleur posé sur la
   page d'accueil). Défilement horizontal sur mobile. Les vidéos viennent de
   la chaîne YouTube (app:sync-youtube-videos) et des médias de l'admin.
   Attend : videos (list<Media>, déjà filtrées sur les vidéos lisibles).
   Rien n'est affiché sans vidéo. Styles : .bb-vrail* dans assets/styles/home.css. #}
{% if videos|length > 0 %}
    {% set channelUrl = site_settings().youtubeUrl %}
    {% set newSince = date('-7 days') %}
    <section id="videos" class="bb-vrail" aria-labelledby="videos-title">
        <div class="bb-container">
            <div class="bb-vrail-head">
                <h2 id="videos-title" class="bb-display bb-mega">Bénin Bouge <span class="bb-accent-mid">en vidéo</span></h2>
                <div class="bb-vrail-actions">
                    <a href="{{ path('app_videos') }}" class="bb-btn bb-btn--ghost">Toutes les vidéos <span aria-hidden="true">→</span></a>
                    {% if channelUrl %}
                        <a href="{{ channelUrl }}" target="_blank" rel="noopener" class="bb-btn bb-btn--gold">La chaîne YouTube</a>
                    {% endif %}
                </div>
            </div>

            <ul class="bb-vrail-list">
                {% for media in videos %}
                    {% set title = media.title ?: (media.article ? media.article.title : 'Vidéo Bénin Bouge') %}
                    <li>
                        <a href="{{ media.youtubeEmbedSrc }}"
                           class="bb-vrail-card{{ loop.first ? ' is-first' }}"
                           data-action="video-modal#open"
                           data-video-modal-url-param="{{ media.youtubeEmbedSrc }}">
                            <span class="bb-vrail-media">
                                {% if media.effectiveThumbnail %}<img src="{{ media.effectiveThumbnail }}" alt="" loading="lazy">{% endif %}
                            </span>
                            {% if media.createdAt and media.createdAt > newSince %}
                                <span class="bb-chip bb-chip--tomato bb-vrail-badge">Nouveau</span>
                            {% endif %}
                            <span class="bb-vrail-play" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11.04-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14Z"/></svg>
                            </span>
                            <span class="bb-vrail-title"><span class="bb-sr-only">Lire la vidéo : </span>{{ title }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endif %}
