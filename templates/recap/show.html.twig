{% extends 'base.html.twig' %}

{# Page d'un Récap : vidéo au format mobile à gauche, texte à droite sur
   ordinateur ; vidéo puis texte empilés sur mobile.
   Styles : .bb-recap* dans assets/styles/content.css. #}
{% set recapUrl = url('app_recap_show', { slug: recap.slug }) %}
{% set metaDescription = (recap.metaDescription ?: recap.content)|excerpt(180) %}

{% block title %}{{ recap.metaTitle ?: recap.title }} | {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: recap.metaTitle ?: recap.title,
        metaDescription: metaDescription,
        canonicalUrl: recapUrl,
        ogType: 'article',
        ogImage: recap.thumbnail,
        structuredData: recap.structuredData,
    }) }}
    {% if not recap.published %}<meta name="robots" content="noindex, nofollow">{% endif %}
{% endblock %}

{% block body %}
{% set shareLinks = [
    { label: 'Partager sur Facebook', href: 'https://www.facebook.com/sharer/sharer.php?u=' ~ recapUrl|url_encode,
      icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>' },
    { label: 'Partager sur X', href: 'https://twitter.com/intent/tweet?url=' ~ recapUrl|url_encode ~ '&text=' ~ recap.title|url_encode,
      icon: '<path fill="currentColor" stroke="none" d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77zm-1.08 16.18h1.7L7.4 4.73H5.58z"/>' },
    { label: 'Partager sur WhatsApp', href: 'https://wa.me/?text=' ~ (recap.title ~ ' ' ~ recapUrl)|url_encode,
      icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>' },
    { label: 'Partager sur LinkedIn', href: 'https://www.linkedin.com/sharing/share-offsite/?url=' ~ recapUrl|url_encode,
      icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>' },
] %}
<div>
    {% if not recap.published %}
        <div class="bb-preview-banner" role="status">
            Aperçu d'un récap qui n'est pas encore public (Brouillon). Seuls les comptes éditeurs et admin voient cette page.
        </div>
    {% endif %}

    {{ include('partials/_header.html.twig') }}

    <main id="contenu">
        <article class="bb-article bb-article--recap">
            <div class="bb-container bb-recap">
                <div class="bb-recap-media">
                    <div class="bb-recap-player">
                        {% if recap.videoYoutubeId %}
                            <iframe src="{{ recap.videoEmbedSrc }}"
                                    title="{{ recap.title }}"
                                    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                                    allowfullscreen
                                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
                        {% else %}
                            <video controls playsinline preload="metadata"{% if recap.coverImage %} poster="{{ recap.coverImage }}"{% endif %}>
                                <source src="{{ recap.videoFileUrl }}">
                                Votre navigateur ne peut pas lire cette vidéo.
                            </video>
                        {% endif %}
                    </div>
                </div>

                <div class="bb-recap-text">
                    <header class="bb-article-head bb-article-head--recap"{% if recap.category %} style="--bb-cat:{{ recap.category.color }}"{% endif %}>
                        <nav class="bb-breadcrumb" aria-label="Fil d'Ariane">
                            <a href="{{ path('app_home') }}">Accueil</a>
                            <span aria-hidden="true">/</span>
                            <a href="{{ path('app_home') }}#recap">Récap</a>
                        </nav>

                        <div class="bb-article-chips">
                            <span class="bb-chip bb-chip--tomato">Récap</span>
                            {% if recap.category %}
                                <a href="{{ path('app_category_show', { slug: recap.category.slug }) }}" class="bb-chip"><span class="bb-dot" aria-hidden="true"></span>{{ recap.category.name }}</a>
                            {% endif %}
                        </div>

                        <h1 class="bb-display bb-article-title">{{ recap.title }}</h1>

                        <div class="bb-article-meta">
                            <p class="bb-article-byline">
                                {% if recap.author %}<strong>{{ recap.author.firstName }} {{ recap.author.lastName }}</strong><span aria-hidden="true">·</span>{% endif %}
                                {% if recap.publishedAt %}<time datetime="{{ recap.publishedAt|date('c') }}">{{ recap.publishedAt|french_date }}</time>{% endif %}
                            </p>
                            <ul class="bb-share" aria-label="Partager le récap">
                                {% for share in shareLinks %}
                                    <li>
                                        <a href="{{ share.href }}" target="_blank" rel="noopener" class="bb-icon-btn bb-share-link" aria-label="{{ share.label }}">
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ share.icon|raw }}</svg>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </header>

                    <div class="bb-article-body bb-prose">{{ recap.content|rich_text }}</div>
                </div>
            </div>
        </article>

        {% if others|length > 0 %}
            <section class="bb-container bb-section--tight bb-recap-rail" aria-labelledby="others-title">
                <div class="bb-sec-head">
                    <h2 id="others-title" class="bb-display bb-h2">Autres récaps</h2>
                </div>
                <ul class="bb-recap-rail-list">
                    {% for other in others %}
                        <li>{{ include('partials/_recap_card.html.twig', { recap: other }) }}</li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </main>

    {{ include('partials/_footer.html.twig') }}
</div>
{% endblock %}
