{% extends 'base.html.twig' %}

{% set tagUrl = url('app_tag_show', { slug: tag.slug }) %}
{% set tagDescription = 'Articles et médias liés au mot-clé « ' ~ tag.name ~ ' » sur ' ~ site_settings().siteName ~ '.' %}

{% block title %}{{ tag.name }} | {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: tag.name ~ ' | ' ~ site_settings().siteName,
        metaDescription: tagDescription,
        canonicalUrl: tagUrl,
    }) }}
{% endblock %}

{% block body %}
    {{ include('partials/_header.html.twig') }}

    <main id="contenu">
        {{ include('partials/_page_head.html.twig', {
            crumbs: [{ label: '#' ~ tag.name }],
            kicker: 'Mot-clé',
            title: '#' ~ tag.name,
            meta: articles|length ~ ' article' ~ (articles|length > 1 ? 's' : '') ~ ' publié' ~ (articles|length > 1 ? 's' : ''),
        }) }}

        <section class="bb-container bb-section--tight" aria-label="Articles du mot-clé">
            {% if articles|length > 0 %}
                <div class="bb-grid-3" data-controller="impression-tracker" data-impression-tracker-context-value="tag_page">
                    {% for article in articles %}
                        {{ include('partials/_article_card.html.twig', { article: article, headingLevel: 2 }) }}
                    {% endfor %}
                </div>
            {% else %}
                <p class="bb-empty">Aucun article publié avec ce mot-clé pour le moment.</p>
            {% endif %}
        </section>

        {% if media|length > 0 %}
            {{ include('partials/_media_grid.html.twig', { media: media }) }}
        {% endif %}
    </main>

    {{ include('partials/_footer.html.twig') }}
{% endblock %}
