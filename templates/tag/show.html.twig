{% extends 'base.html.twig' %}

{% set tagUrl = url('app_tag_show', { slug: tag.slug }) %}
{% set tagDescription = 'Articles et médias liés au mot-clé « ' ~ tag.name ~ ' » sur ' ~ site_settings().siteName ~ '.' %}

{% block title %}{{ tag.name }} | {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:ital,wght@0,500;0,600;0,700;0,800;0,900;1,700;1,800;1,900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: tag.name ~ ' | ' ~ site_settings().siteName,
        metaDescription: tagDescription,
        canonicalUrl: tagUrl,
    }) }}
{% endblock %}

{% block body %}
{% set gradientPalette = [
    'linear-gradient(140deg,#0E3F51,#2B6B43)',
    'linear-gradient(140deg,#CF3732,#a3140d)',
    'linear-gradient(140deg,#3a3f33,#14160F)',
    'linear-gradient(140deg,#3A8556,#1C4A2E)',
] %}

<div style="background:var(--bb-bg);color:#14160F;font-family:'Manrope',sans-serif">

    {{ include('partials/_header.html.twig') }}

    {# ===== EN-TÊTE MOT-CLÉ ===== #}
    <section style="max-width:var(--bb-container);margin:0 auto;padding:54px 24px 10px">
        <div style="display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:#8a8a7c;margin-bottom:18px">
            <a href="{{ path('app_home') }}" style="text-decoration:none;color:#8a8a7c">Accueil</a>
            <span>/</span>
            <span style="color:#3a3f33">{{ tag.name }}</span>
        </div>
        <span style="display:inline-block;background:#0E3F51;color:#fff;font-weight:800;font-size:11.5px;letter-spacing:.5px;padding:7px 16px;border-radius:999px;text-transform:uppercase">Mot-clé</span>
        <h1 style="font-family:'Archivo';font-weight:900;font-size:36px;color:#14160F;margin-top:16px;letter-spacing:-.4px">#{{ tag.name }}</h1>
        <div style="color:#8a8a7c;font-size:12.5px;font-weight:600;margin-top:14px">{{ articles|length }} article{{ articles|length > 1 ? 's' : '' }} publié{{ articles|length > 1 ? 's' : '' }}</div>
    </section>

    {# ===== ARTICLES DU MOT-CLÉ ===== #}
    <section style="max-width:var(--bb-container);margin:0 auto;padding:34px 24px 24px">
        {% if articles|length > 0 %}
        <div class="bb-grid-3" style="gap:32px" data-controller="impression-tracker" data-impression-tracker-context-value="tag_page">
            {% for article in articles %}
                {% set gradient = gradientPalette[loop.index0 % 4] %}
                {{ include('partials/_article_card.html.twig', { article: article, gradient: gradient }) }}
            {% endfor %}
        </div>
        {% else %}
            <p class="bb-empty">Aucun article publié avec ce mot-clé pour le moment.</p>
        {% endif %}
    </section>

    {# ===== MÉDIAS DU MOT-CLÉ ===== #}
    {% if media|length > 0 %}
    <section style="max-width:var(--bb-container);margin:0 auto;padding:0 24px 64px">
        <h2 style="font-family:'Archivo';font-weight:900;font-size:22px;color:#14160F;margin-bottom:18px;letter-spacing:-.3px">Médias</h2>
        <div class="bb-grid-4" style="gap:16px">
            {% for item in media %}
                {% set mediaLink = item.article ? path('app_article_show', { slug: item.article.slug }) : (item.imageUrl ?: item.youtubeEmbedUrl ?: item.audioUrl ?: item.documentUrl) %}
                <a href="{{ mediaLink ?: '#' }}" {% if not item.article %}target="_blank" rel="noopener"{% endif %} style="text-decoration:none;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 8px 20px -18px rgba(20,22,15,.5);display:block">
                    <div style="position:relative;aspect-ratio:16/10;background:{{ gradientPalette[loop.index0 % 4] }}">
                        {% if item.effectiveThumbnail or item.imageUrl %}
                            <div style="position:absolute;inset:0;background:url('{{ item.effectiveThumbnail ?: item.imageUrl }}') center/cover"></div>
                        {% endif %}
                        <span style="position:absolute;top:8px;left:8px;background:rgba(20,22,15,.72);color:#fff;font-size:9.5px;font-weight:800;letter-spacing:.4px;padding:3px 8px;border-radius:5px;text-transform:uppercase">{{ item.type.value }}</span>
                    </div>
                    <div style="padding:10px 12px 13px">
                        <h3 style="font-family:'Archivo';font-weight:700;font-size:13px;line-height:1.25;color:#14160F">{{ item.title ?: 'Sans titre' }}</h3>
                    </div>
                </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {{ include('partials/_footer.html.twig') }}

</div>
{% endblock %}
