{% extends 'base.html.twig' %}

{% set videoIndexUrl = page > 1 ? url('app_videos', { page: page }) : url('app_videos') %}

{% block title %}Vidéos{% if page > 1 %} (page {{ page }}){% endif %} | {{ site_settings().siteName }}{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:ital,wght@0,500;0,600;0,700;0,800;0,900;1,700;1,800;1,900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {{ include('partials/_seo_meta.html.twig', {
        ogTitle: 'Vidéos | ' ~ site_settings().siteName,
        metaDescription: 'Retrouvez tous les reportages, interviews et formats courts filmés sur le terrain par ' ~ site_settings().siteName ~ '.',
        canonicalUrl: videoIndexUrl,
    }) }}
{% endblock %}

{% block body %}
{% set gradientPalette = [
    'linear-gradient(140deg,#0E3F51,#2B6B43)',
    'linear-gradient(140deg,#CF3732,#a3140d)',
    'linear-gradient(140deg,#3a3f33,#14160F)',
    'linear-gradient(140deg,#3A8556,#1C4A2E)',
] %}

<div style="background:var(--bb-bg);color:#14160F;font-family:'Manrope',sans-serif" data-controller="video-modal">

    {{ include('partials/_header.html.twig') }}

    {# ===== EN-TÊTE PAGE ===== #}
    <section style="max-width:var(--bb-container);margin:0 auto;padding:54px 24px 10px">
        <div style="display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:#8a8a7c;margin-bottom:18px">
            <a href="{{ path('app_home') }}" style="text-decoration:none;color:#8a8a7c">Accueil</a>
            <span>/</span>
            <span style="color:#3a3f33">Vidéos</span>
        </div>
        <span style="display:inline-block;background:#CF3732;color:#fff;font-weight:800;font-size:11.5px;letter-spacing:.5px;padding:7px 16px;border-radius:999px;text-transform:uppercase">Vidéos</span>
        <h1 style="font-family:'Archivo';font-weight:900;font-size:36px;color:#14160F;margin-top:16px;letter-spacing:-.4px">Le Bénin <em style="font-style:italic;color:#2B6B43">en images</em></h1>
        <p style="color:#51544a;font-size:15px;line-height:1.7;margin-top:12px;max-width:520px">Retrouvez tous les reportages, interviews et formats courts filmés sur le terrain par {{ site_settings().siteName }}.</p>
    </section>

    {# ===== GRILLE VIDÉOS ===== #}
    <section style="max-width:var(--bb-container);margin:0 auto;padding:34px 24px 64px">
        {% if videos|length > 0 %}
        <div class="bb-grid-3" style="gap:24px">
            {% for media in videos %}
                {{ include('partials/_video_card.html.twig', { media: media, gradient: gradientPalette[loop.index0 % 4] }) }}
            {% endfor %}
        </div>
        {{ include('partials/_pagination.html.twig', { page: page, pageCount: pageCount, route: 'app_videos' }) }}
        {% else %}
            <p class="bb-empty">Aucune vidéo publiée pour le moment.</p>
        {% endif %}
    </section>

    {{ include('partials/_video_modal.html.twig') }}

    {{ include('partials/_footer.html.twig') }}

</div>
{% endblock %}
